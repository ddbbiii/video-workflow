[CmdletBinding()]
param(
    [string]$ComfyUrl = 'http://127.0.0.1:8188',
    [string]$RunId = (Get-Date -Format 'yyyyMMdd-HHmmss'),
    [int]$Width = 768,
    [int]$Height = 432,
    [int]$TimeoutSeconds = 900
)

$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$projectRoot = 'E:\program\1project\video'
$runRoot = Join-Path $projectRoot "production\series\UA001-door-0213\review\runs\UA001-P1-low-risk-person-candidates\$RunId"
$comfyOutput = 'E:\program\1project\video\shared\runtime\comfy\models\output'
New-Item -ItemType Directory -Force -Path $runRoot | Out-Null

$commonPositive = 'mature psychological suspense anime, grounded adult television-anime visual language, restrained semi-realistic cel shading, controlled fine dark linework, low-key practical lighting, deep coherent shadows, desaturated cold gray-blue and blue-black palette, subtle worn texture, native 16:9 landscape, old apartment building at night, pseudodocumentary evidence image'
$commonNegative = 'cute, chibi, child, teenager, school uniform, pastel, pink, warm luxury interior, cozy, photorealistic, live action, 3d render, text, letters, numbers, watermark, logo, signature, vertical, pillarbox, collage, split screen, fisheye, distorted perspective, face closeup, visible face, hands near face, hand touching face, extra fingers, fused fingers, malformed hand, extra arm, extra limb, duplicate person, multiple people, camera, smartphone, selfie, filming pose'

$jobs = @(
    [ordered]@{ id='UA001-P1-INVESTIGATOR-BACK-A'; seed=[UInt64]8200101; label='1 Investigator back / corridor'; positive='single adult investigator seen only from behind, wearing a long dark charcoal coat, standing still five meters from an old apartment door in a narrow cold-gray corridor, head slightly lowered, face completely hidden, hands below frame, person occupies less than twenty percent of frame, stable eye-level wide composition, 713 door area as spatial focal point' },
    [ordered]@{ id='UA001-P1-DEVICE-HAND-A'; seed=[UInt64]8200102; label='2 Sleeved hand / door sensor'; positive='evidence close shot of one sleeved adult forearm holding a small opaque rectangular door-magnetic sensor beside an old apartment lock, device blocks most fingers, only simple natural thumb edge visible, no face, no other arm, no phone and no camera, cold cyan inspection light, old door texture and torn seal in background, stable normal lens' },
    [ordered]@{ id='UA001-P1-CCTV-FIGURE-A'; seed=[UInt64]8200103; label='3 CCTV distant figure'; positive='surveillance-camera style wide view of an empty old apartment corridor, a single indistinct adult-height blurred figure very far away at the vanishing point, no facial detail, no visible hands, fixed ceiling camera angle, muted scanline texture, cold gray-blue, door geometry remains readable, evidence frame without readable text' },
    [ordered]@{ id='UA001-P1-INNER-ARM-A'; seed=[UInt64]8200104; label='4 Inner door shoulder/arm'; positive='view from inside a partially opened dark apartment doorway into an impossible blue-black inner corridor, only the back shoulder and one relaxed sleeved upper arm of a single adult figure at the extreme foreground edge, face and hands fully out of frame, no interaction, lights subtly too far apart, stable doorway composition' }
)

function New-Workflow([System.Collections.IDictionary]$Job) {
    $positive = "$commonPositive, $($Job.positive)"
    [ordered]@{
        '1' = @{ class_type='CheckpointLoaderSimple'; inputs=@{ ckpt_name='counterfeitxl-v2.5.safetensors' } }
        '2' = @{ class_type='CLIPTextEncode'; inputs=@{ text=$positive; clip=@('1',1) } }
        '3' = @{ class_type='CLIPTextEncode'; inputs=@{ text=$commonNegative; clip=@('1',1) } }
        '4' = @{ class_type='EmptyLatentImage'; inputs=@{ width=$Width; height=$Height; batch_size=1 } }
        '5' = @{ class_type='KSampler'; inputs=@{ model=@('1',0); positive=@('2',0); negative=@('3',0); latent_image=@('4',0); seed=$Job.seed; steps=26; cfg=5.7; sampler_name='dpmpp_2m'; scheduler='karras'; denoise=1.0 } }
        '6' = @{ class_type='VAEDecode'; inputs=@{ samples=@('5',0); vae=@('1',2) } }
        '7' = @{ class_type='SaveImage'; inputs=@{ images=@('6',0); filename_prefix="series/UA001-door-0213/$RunId/$($Job.id)" } }
    }
}
function Submit-Workflow([hashtable]$Prompt, [string]$ClientId) {
    $body=@{prompt=$Prompt;client_id=$ClientId}|ConvertTo-Json -Depth 20
    $r=Invoke-RestMethod -Uri "$ComfyUrl/prompt" -Method Post -ContentType 'application/json' -Body $body -TimeoutSec 60
    if((@($r.PSObject.Properties|ForEach-Object Name)-contains 'node_errors') -and (@($r.node_errors.PSObject.Properties)).Count -gt 0){throw ($r.node_errors|ConvertTo-Json -Depth 12)}
    return [string]$r.prompt_id
}
function Wait-ForOutput([string]$PromptId,[datetime]$Deadline){while((Get-Date)-lt $Deadline){$history=Invoke-RestMethod -Uri "$ComfyUrl/history/$PromptId" -TimeoutSec 15;if((@($history.PSObject.Properties|ForEach-Object Name)-contains $PromptId)){$entry=$history.PSObject.Properties[$PromptId].Value;if($entry.status.status_str -eq 'error'){throw($entry.status|ConvertTo-Json -Depth 12)};if($entry.status.completed){$image=$entry.outputs.'7'.images[0];return Join-Path $comfyOutput (Join-Path $image.subfolder $image.filename)}};Start-Sleep -Seconds 3};throw "Timed out: $PromptId"}
function New-ContactSheet([object[]]$Items,[string]$Path){Add-Type -AssemblyName System.Drawing;$tw=384;$th=216;$lh=32;$m=14;$head=44;$cols=2;$rows=[math]::Ceiling((@($Items)).Count/$cols);$sheet=New-Object System.Drawing.Bitmap (($m*($cols+1))+$tw*$cols),($head+$m*($rows+1)+($th+$lh)*$rows);$g=[System.Drawing.Graphics]::FromImage($sheet);try{$g.Clear([System.Drawing.Color]::FromArgb(15,18,23));$g.InterpolationMode=[System.Drawing.Drawing2D.InterpolationMode]::HighQualityBicubic;$title=New-Object System.Drawing.Font('Segoe UI',14,[System.Drawing.FontStyle]::Bold);$label=New-Object System.Drawing.Font('Segoe UI',10,[System.Drawing.FontStyle]::Bold);$brush=New-Object System.Drawing.SolidBrush([System.Drawing.Color]::White);try{$g.DrawString('UA001 P1 — low-risk person review candidates',$title,$brush,$m,10);for($i=0;$i-lt(@($Items)).Count;$i++){$col=$i%$cols;$row=[math]::Floor($i/$cols);$x=$m+$col*($tw+$m);$y=$head+$m+$row*($th+$lh+$m);$src=[System.Drawing.Image]::FromFile($Items[$i].output);try{$g.DrawImage($src,$x,$y,$tw,$th)}finally{$src.Dispose()};$g.DrawString($Items[$i].label,$label,$brush,$x,$y+$th+4)};$sheet.Save($Path,[System.Drawing.Imaging.ImageFormat]::Png)}finally{$title.Dispose();$label.Dispose();$brush.Dispose()}}finally{$g.Dispose();$sheet.Dispose()}}

$queue=Invoke-RestMethod -Uri "$ComfyUrl/queue" -TimeoutSec 15
if((@($queue.queue_running)).Count -or (@($queue.queue_pending)).Count){throw 'Refusing to submit: ComfyUI queue is not empty.'}
$started=Get-Date;$deadline=$started.AddSeconds($TimeoutSeconds);$queued=@();$results=@();$runOutput=Join-Path $comfyOutput "series\UA001-door-0213\$RunId"
foreach($job in $jobs){$existing=@(Get-ChildItem -LiteralPath $runOutput -Filter "$($job.id)_*.png" -File -ErrorAction SilentlyContinue|Sort-Object LastWriteTime|Select-Object -First 1);if($existing.Count -gt 0){$results += [pscustomobject]@{id=$job.id;label=$job.label;seed=$job.seed;prompt_id=$null;prompt_path=$null;output=$existing[0].FullName;sha256=(Get-FileHash -LiteralPath $existing[0].FullName -Algorithm SHA256).Hash.ToLowerInvariant();status='pending-user-review';promotion='forbidden-until-explicit-approval';recovered_from_interrupted_submission=$true};continue};$wf=New-Workflow $job;$pp=Join-Path $runRoot "$($job.id)-prompt.json";$wf|ConvertTo-Json -Depth 20|Set-Content -LiteralPath $pp -Encoding utf8;$promptId=Submit-Workflow $wf "ua001-p1-$RunId-$($job.id)";$queued += [pscustomobject]@{id=$job.id;label=$job.label;seed=$job.seed;prompt_id=$promptId;prompt_path=$pp;positive_prompt="$commonPositive, $($job.positive)";negative_prompt=$commonNegative}}
foreach($item in $queued){$output=Wait-ForOutput $item.prompt_id $deadline;$results += [pscustomobject]@{id=$item.id;label=$item.label;seed=$item.seed;prompt_id=$item.prompt_id;prompt_path=$item.prompt_path;output=$output;sha256=(Get-FileHash -LiteralPath $output -Algorithm SHA256).Hash.ToLowerInvariant();status='pending-user-review';promotion='forbidden-until-explicit-approval'}}
$sheet=Join-Path $runRoot 'UA001-P1-low-risk-person-candidates-v1-contact-sheet.png';New-ContactSheet $results $sheet
$observedFiles=@($results|ForEach-Object{Get-Item -LiteralPath $_.output}|Sort-Object LastWriteTime);$observedStart=$observedFiles[0].LastWriteTime;$observedEnd=$observedFiles[-1].LastWriteTime
$manifest=[ordered]@{run_id=$RunId;status='pending-user-review';created_at=$started.ToString('o');completed_at=(Get-Date).ToString('o');manifest_assembly_elapsed_seconds=[math]::Round(((Get-Date)-$started).TotalSeconds,2);observed_output_window_start=$observedStart.ToString('o');observed_output_window_end=$observedEnd.ToString('o');observed_output_window_seconds=[math]::Round(($observedEnd-$observedStart).TotalSeconds,2);timing_note='Observed output window is the reliable timing record; the original parent shell command timed out after submission while ComfyUI completed the queued images.';purpose='UA001 review-only low-risk human presence candidates';resolution="$Width`x$Height";checkpoint='counterfeitxl-v2.5.safetensors';contact_sheet=$sheet;results=$results;approval_gate='No output is a formal asset or approved ComfyUI input until explicit user approval.'}
$manifestPath=Join-Path $runRoot 'UA001-P1-low-risk-person-candidates-v1-manifest.json';$manifest|ConvertTo-Json -Depth 15|Set-Content -LiteralPath $manifestPath -Encoding utf8
[pscustomobject]@{run_root=$runRoot;contact_sheet=$sheet;manifest=$manifestPath;observed_output_window_seconds=$manifest.observed_output_window_seconds;count=(@($results)).Count}|ConvertTo-Json -Compress
