{
 "cues": [
  {
   "start": 0.0,
   "end": 2.615538461538461,
   "text": "晚上九点四十，你从公司出来"
  },
  {
   "start": 2.615538461538461,
   "end": 5.667,
   "text": "地铁上站了四十分钟，脚后跟发疼"
  },
  {
   "start": 5.667,
   "end": 9.340172413793104,
   "text": "回到出租屋，你把背包一扔，先点开拼好饭"
  },
  {
   "start": 9.340172413793104,
   "end": 11.933,
   "text": "看有没有满减，翻了七八分钟"
  },
  {
   "start": 11.933,
   "end": 14.975148148148149,
   "text": "一荤一素，十九块八，你凑了个满减"
  },
  {
   "start": 14.975148148148149,
   "end": 17.8,
   "text": "最后付了十八块四，刚好够起送"
  },
  {
   "start": 17.8,
   "end": 20.19025925925926,
   "text": "吃完你把泡沫盒推到桌角"
  },
  {
   "start": 20.19025925925926,
   "end": 23.667,
   "text": "人跟着瘫到床上，灯都没关，手机还亮着"
  },
  {
   "start": 23.667,
   "end": 27.13366666666667,
   "text": "短视频一个接一个，你刷到教人入睡的"
  },
  {
   "start": 27.13366666666667,
   "end": 30.167,
   "text": "看了两遍，还是没睡着，窗外已安静"
  },
  {
   "start": 30.167,
   "end": 34.27231034482759,
   "text": "十一点半，你去洗漱，换上那件洗得发白的睡衣"
  },
  {
   "start": 34.27231034482759,
   "end": 36.433,
   "text": "袖口早松了，领口磨破边"
  },
  {
   "start": 36.433,
   "end": 40.333214285714284,
   "text": "手机定好七点半的闹钟，你把它扣在枕头边"
  },
  {
   "start": 40.333214285714284,
   "end": 42.5,
   "text": "屏幕朝下，怕半夜晃眼睛"
  },
  {
   "start": 42.5,
   "end": 44.87713793103448,
   "text": "窗外是高架，车声一阵一阵"
  },
  {
   "start": 44.87713793103448,
   "end": 48.767,
   "text": "像有人在很远的地方推铁皮，推过去又拉回"
  },
  {
   "start": 48.767,
   "end": 52.233285714285714,
   "text": "这间屋子你住了两年，墙角掉了一块皮"
  },
  {
   "start": 52.233285714285714,
   "end": 54.833,
   "text": "一直没补，房东也没上来看过"
  },
  {
   "start": 54.833,
   "end": 57.87514814814815,
   "text": "凌晨一点多，楼道里传来敲门声，咚"
  },
  {
   "start": 57.87514814814815,
   "end": 60.7,
   "text": "咚，像用拳头砸的，不是用手指敲"
  },
  {
   "start": 60.7,
   "end": 63.95017857142857,
   "text": "第三下刚响到一半，外面一下子死静"
  },
  {
   "start": 63.95017857142857,
   "end": 66.767,
   "text": "连回声都没有，声控灯也没再亮"
  },
  {
   "start": 66.767,
   "end": 69.36671428571428,
   "text": "你翻了个身，嘟囔了一句醉汉"
  },
  {
   "start": 69.36671428571428,
   "end": 72.833,
   "text": "闭眼接着睡，完全没当回事，眼皮都没睁"
  },
  {
   "start": 72.833,
   "end": 76.53834615384615,
   "text": "后来你才知道，那天夜里你什么都没察觉"
  },
  {
   "start": 76.53834615384615,
   "end": 78.5,
   "text": "睡得很沉，一觉到天亮"
  },
  {
   "start": 78.5,
   "end": 81.33454166666667,
   "text": "整栋楼只有三户人家的灯亮过"
  },
  {
   "start": 81.33454166666667,
   "end": 83.733,
   "text": "一户亮了三分钟，一直没熄"
  },
  {
   "start": 83.733,
   "end": 86.34055555555555,
   "text": "一户亮了一下就灭，还有一户"
  },
  {
   "start": 86.34055555555555,
   "end": 89.6,
   "text": "亮到天亮都没人去关，灯照到楼道里"
  },
  {
   "start": 89.6,
   "end": 92.21553846153846,
   "text": "你睡得很沉，闹钟设在七点半"
  },
  {
   "start": 92.21553846153846,
   "end": 95.267,
   "text": "被子拉到下巴，手机压在枕头底下"
  },
  {
   "start": 95.267,
   "end": 97.4402,
   "text": "早上七点半，闹钟还没响"
  },
  {
   "start": 97.4402,
   "end": 100.7,
   "text": "手机先震醒了你，隔着枕头嗡嗡地响"
  },
  {
   "start": 100.7,
   "end": 104.61133333333333,
   "text": "业主群九十九条未读，从凌晨三点就开始刷"
  },
  {
   "start": 104.61133333333333,
   "end": 106.567,
   "text": "最后一条停在四点多"
  },
  {
   "start": 106.567,
   "end": 109.39215999999999,
   "text": "六楼的人说，他媳妇拧钥匙开门"
  },
  {
   "start": 109.39215999999999,
   "end": 112.0,
   "text": "拧到第三下，钥匙还没拔出来"
  },
  {
   "start": 112.0,
   "end": 113.9694347826087,
   "text": "人就倒在门口，脸朝下"
  },
  {
   "start": 113.9694347826087,
   "end": 117.033,
   "text": "一只手还搭在门框上，鞋掉了一只"
  },
  {
   "start": 117.033,
   "end": 119.64853846153846,
   "text": "三楼的住户说，他按客厅开关"
  },
  {
   "start": 119.64853846153846,
   "end": 122.7,
   "text": "按了三次，第三次手还搭在开关上"
  },
  {
   "start": 122.7,
   "end": 124.88826086956522,
   "text": "第三次按下去，人就没了"
  },
  {
   "start": 124.88826086956522,
   "end": 127.733,
   "text": "屋里的灯还亮着，电视也还开着"
  },
  {
   "start": 127.733,
   "end": 130.55785185185186,
   "text": "还有人拍窗户喊人，拍到第三下"
  },
  {
   "start": 130.55785185185186,
   "end": 133.6,
   "text": "直直倒在窗边，窗户还开着一条缝"
  },
  {
   "start": 133.6,
   "end": 137.30534615384616,
   "text": "你盯着屏幕，第一反应是这群人在开玩笑"
  },
  {
   "start": 137.30534615384616,
   "end": 139.267,
   "text": "或者是哪个号被盗了"
  },
  {
   "start": 139.267,
   "end": 142.75376923076922,
   "text": "可你往上翻，发消息的人一个都没再回"
  },
  {
   "start": 142.75376923076922,
   "end": 144.933,
   "text": "最后一条也停在四点多"
  },
  {
   "start": 144.933,
   "end": 147.867,
   "text": "屋里的东西，你闭着眼都摸得到"
  },
  {
   "start": 147.867,
   "end": 150.26415384615385,
   "text": "你走到桌前，伸出右手食指"
  },
  {
   "start": 150.26415384615385,
   "end": 153.533,
   "text": "在桌面上按了一下，桌面有一层薄灰"
  },
  {
   "start": 153.533,
   "end": 156.58446153846154,
   "text": "第二下，你按得慢了一点，指节发白"
  },
  {
   "start": 156.58446153846154,
   "end": 159.2,
   "text": "桌面留了个圆印，灰往两边挤"
  },
  {
   "start": 159.2,
   "end": 162.02516,
   "text": "第三下，手指伸到一半，你停住了"
  },
  {
   "start": 162.02516,
   "end": 164.633,
   "text": "指尖抖得厉害，离桌面两指宽"
  },
  {
   "start": 164.633,
   "end": 167.02396000000002,
   "text": "你换了支笔，用笔尾按下去"
  },
  {
   "start": 167.02396000000002,
   "end": 170.067,
   "text": "什么事都没有，笔杆上有一圈牙印"
  },
  {
   "start": 170.067,
   "end": 172.0364347826087,
   "text": "你又换左手，按了两下"
  },
  {
   "start": 172.0364347826087,
   "end": 175.1,
   "text": "还是什么事都没有，手心里全是汗"
  },
  {
   "start": 175.1,
   "end": 177.50708695652173,
   "text": "你坐在椅子上，心跳得很快"
  },
  {
   "start": 177.50708695652173,
   "end": 180.133,
   "text": "后背一层汗，耳朵一直是热的"
  },
  {
   "start": 180.133,
   "end": 182.75,
   "text": "规则很简单：同一个主动动作"
  },
  {
   "start": 182.75,
   "end": 185.367,
   "text": "做到第三次，人就死，没有例外"
  },
  {
   "start": 185.367,
   "end": 188.22286363636363,
   "text": "换手、换姿势、换工具，都算新动作"
  },
  {
   "start": 188.22286363636363,
   "end": 190.2,
   "text": "从头数，第三次照样死"
  },
  {
   "start": 190.2,
   "end": 193.02516,
   "text": "走路、呼吸、眨眼这种停不下来的"
  },
  {
   "start": 193.02516,
   "end": 195.633,
   "text": "不算，不然没人活得了一分钟"
  },
  {
   "start": 195.633,
   "end": 198.9024230769231,
   "text": "你拿起杯子喝水，很自然地喝了两口"
  },
  {
   "start": 198.9024230769231,
   "end": 201.3,
   "text": "眼睛还看着窗外，手没有停"
  },
  {
   "start": 201.3,
   "end": 203.69757692307692,
   "text": "第三口，嘴唇已经碰到杯沿"
  },
  {
   "start": 203.69757692307692,
   "end": 206.967,
   "text": "杯里的水面晃了一下，你整个人僵住"
  },
  {
   "start": 206.967,
   "end": 209.36545833333332,
   "text": "你停住，杯子慢慢放回桌上"
  },
  {
   "start": 209.36545833333332,
   "end": 212.2,
   "text": "杯底磕出一声响，水溅出来一点"
  },
  {
   "start": 212.2,
   "end": 214.5975769230769,
   "text": "你翻出一根吸管，插进杯子"
  },
  {
   "start": 214.5975769230769,
   "end": 217.867,
   "text": "一口一口吸到底，吸管被咬扁了一截"
  },
  {
   "start": 217.867,
   "end": 220.90948,
   "text": "喝完那杯水，你靠在墙上，腿有点软"
  },
  {
   "start": 220.90948,
   "end": 223.3,
   "text": "顺着墙滑了半截，坐到地上"
  },
  {
   "start": 223.3,
   "end": 226.34248,
   "text": "你开始清点屋里的东西：半箱泡面"
  },
  {
   "start": 226.34248,
   "end": 228.733,
   "text": "四瓶矿泉水，还有半袋面包"
  },
  {
   "start": 228.733,
   "end": 231.77604,
   "text": "两包榨菜，一罐过期两个月的黄桃"
  },
  {
   "start": 231.77604,
   "end": 234.167,
   "text": "冰箱里半盒鸡蛋，两瓶啤酒"
  },
  {
   "start": 234.167,
   "end": 237.20947999999999,
   "text": "按你平时的吃法，这些最多撑七天"
  },
  {
   "start": 237.20947999999999,
   "end": 239.6,
   "text": "省着吃也许十天，水最要紧"
  },
  {
   "start": 239.6,
   "end": 242.86942307692308,
   "text": "从这天起，你把每个动作都拆成两套"
  },
  {
   "start": 242.86942307692308,
   "end": 245.267,
   "text": "先想再动手，动手之前先数"
  },
  {
   "start": 245.267,
   "end": 247.89291304347827,
   "text": "右手开灯，左手关灯；右手拧盖"
  },
  {
   "start": 247.89291304347827,
   "end": 250.3,
   "text": "左手倒水；连抽纸都要换手"
  },
  {
   "start": 250.3,
   "end": 252.91649999999998,
   "text": "你在心里数着，一二，换，一二，换"
  },
  {
   "start": 252.91649999999998,
   "end": 255.533,
   "text": "数到后来就乱，自己都分不清"
  },
  {
   "start": 255.533,
   "end": 258.9,
   "text": "天黑得比平时早，屋里只开了一盏灯"
  },
  {
   "start": 258.9,
   "end": 262.1415517241379,
   "text": "数到晚上，你发现自己的手一直在抖"
  },
  {
   "start": 262.1415517241379,
   "end": 265.167,
   "text": "端水杯时抖得更厉害，水洒在桌上"
  },
  {
   "start": 265.167,
   "end": 268.4080344827586,
   "text": "天黑之前，你把门反锁，又用椅子顶住"
  },
  {
   "start": 268.4080344827586,
   "end": 271.433,
   "text": "顶了两回才卡稳，椅子腿抵着地砖"
  },
  {
   "start": 271.433,
   "end": 274.25868,
   "text": "椅子只有一把，你把它挪来挪去"
  },
  {
   "start": 274.25868,
   "end": 276.867,
   "text": "挪了三次，每挪一次都重新数"
  },
  {
   "start": 276.867,
   "end": 279.48207692307693,
   "text": "第三次挪的时候，你猛地停住"
  },
  {
   "start": 279.48207692307693,
   "end": 282.533,
   "text": "椅子歪在地上，一条腿磕在地砖上"
  },
  {
   "start": 282.533,
   "end": 284.9232592592593,
   "text": "你蹲下去扶起来，扶了两下"
  },
  {
   "start": 284.9232592592593,
   "end": 288.4,
   "text": "第三下用脚踢正，然后退开半步看着它"
  },
  {
   "start": 288.4,
   "end": 291.44214814814814,
   "text": "那一晚你没关灯，坐在床上，听楼道"
  },
  {
   "start": 291.44214814814814,
   "end": 294.267,
   "text": "听到眼睛发酸，也没等到第四声"
  },
  {
   "start": 294.267,
   "end": 296.4402,
   "text": "楼道里什么声音都没有"
  },
  {
   "start": 296.4402,
   "end": 299.7,
   "text": "安静得像被人按住了，连风都不进来"
  },
  {
   "start": 299.7,
   "end": 303.18738461538464,
   "text": "天快亮的时候你才睡着，梦里还在数数"
  },
  {
   "start": 303.18738461538464,
   "end": 305.367,
   "text": "数到三就醒，醒了接着数"
  },
  {
   "start": 305.367,
   "end": 309.8845666666667,
   "text": "醒来第一件事，是看自己的手有没有做过什么"
  },
  {
   "start": 309.8845666666667,
   "end": 312.5,
   "text": "翻来覆去看了很久才下床"
  },
  {
   "start": 312.5,
   "end": 316.067,
   "text": "窗户外面是小区院子，晾衣绳在风里晃"
  },
  {
   "start": 316.067,
   "end": 318.6820769230769,
   "text": "第二天早上，你想开窗透口气"
  },
  {
   "start": 318.6820769230769,
   "end": 321.733,
   "text": "玻璃上有一层水汽，屋里全是闷味"
  },
  {
   "start": 321.733,
   "end": 324.34132,
   "text": "窗户有点紧，你推了一下，没动"
  },
  {
   "start": 324.34132,
   "end": 327.167,
   "text": "窗槽里全是灰和死掉的小飞虫"
  },
  {
   "start": 327.167,
   "end": 329.99137037037036,
   "text": "第二下，你用了点力，窗开了条缝"
  },
  {
   "start": 329.99137037037036,
   "end": 333.033,
   "text": "灰从缝里飞起来，外面的光切进来"
  },
  {
   "start": 333.033,
   "end": 336.7383461538461,
   "text": "第三下，你抬手的时候，脑子里在想别的事"
  },
  {
   "start": 336.7383461538461,
   "end": 338.7,
   "text": "想早点摊今天开不开"
  },
  {
   "start": 338.7,
   "end": 342.18738461538464,
   "text": "指尖已经碰到窗框，你猛地把手抽回来"
  },
  {
   "start": 342.18738461538464,
   "end": 344.367,
   "text": "停在胸前，半天才放下来"
  },
  {
   "start": 344.367,
   "end": 346.99291304347827,
   "text": "手背撞在墙棱上，擦破一大块"
  },
  {
   "start": 346.99291304347827,
   "end": 349.4,
   "text": "血珠慢慢渗出来，流到手腕"
  },
  {
   "start": 349.4,
   "end": 352.333,
   "text": "楼下一个人也没有，连狗都不叫"
  },
  {
   "start": 352.333,
   "end": 355.59340000000003,
   "text": "你站在窗边喘气，窗外一个人都没有"
  },
  {
   "start": 355.59340000000003,
   "end": 357.767,
   "text": "晾衣绳在晃，院子里空着"
  },
  {
   "start": 357.767,
   "end": 360.81958333333336,
   "text": "楼下早点摊还支着，蒸笼冒着白汽"
  },
  {
   "start": 360.81958333333336,
   "end": 363.0,
   "text": "凳子倒在地上，锅盖掀着"
  },
  {
   "start": 363.0,
   "end": 366.25944444444445,
   "text": "你翻出一个本子，在第一页写下日期"
  },
  {
   "start": 366.25944444444445,
   "end": 368.867,
   "text": "笔尖戳破了纸，留下一个小坑"
  },
  {
   "start": 368.867,
   "end": 371.05747619047617,
   "text": "喝水、开门、按开关、拿东西"
  },
  {
   "start": 371.05747619047617,
   "end": 373.467,
   "text": "各占一行，后面都留着空白"
  },
  {
   "start": 373.467,
   "end": 376.0820769230769,
   "text": "每做一次，你划一道；两道之后"
  },
  {
   "start": 376.0820769230769,
   "end": 379.133,
   "text": "立刻换姿势，第三道的笔停在半空"
  },
  {
   "start": 379.133,
   "end": 382.1665,
   "text": "本子写满一页，你的手也稳了一点"
  },
  {
   "start": 382.1665,
   "end": 385.2,
   "text": "窗外的光挪到了桌上，屋里亮起来"
  },
  {
   "start": 385.2,
   "end": 388.8835357142857,
   "text": "楼道从早到晚没有声音，连拖鞋声都没有"
  },
  {
   "start": 388.8835357142857,
   "end": 391.267,
   "text": "安静得能听见自己吞口水"
  },
  {
   "start": 391.267,
   "end": 395.16657142857144,
   "text": "中午你贴着门听，听见隔壁有人在小声咳嗽"
  },
  {
   "start": 395.16657142857144,
   "end": 397.333,
   "text": "咳完停一会儿，再咳两声"
  },
  {
   "start": 397.333,
   "end": 400.15868,
   "text": "你敲了两下门板，停住，等那边回"
  },
  {
   "start": 400.15868,
   "end": 402.767,
   "text": "手悬在半空，没有落到第三下"
  },
  {
   "start": 402.767,
   "end": 406.4604074074074,
   "text": "那边也敲了两下，然后是一个男人的声音"
  },
  {
   "start": 406.4604074074074,
   "end": 408.633,
   "text": "他说他叫老陈，住你隔壁"
  },
  {
   "start": 408.633,
   "end": 411.0164642857143,
   "text": "他说他昨天一天没敢出门"
  },
  {
   "start": 411.0164642857143,
   "end": 414.7,
   "text": "家里的水快喝完了，问你这儿有没有多的"
  },
  {
   "start": 414.7,
   "end": 418.40534615384615,
   "text": "你们隔着一扇门，把知道的规则一条条对"
  },
  {
   "start": 418.40534615384615,
   "end": 420.367,
   "text": "对一条，心里就沉一点"
  },
  {
   "start": 420.367,
   "end": 423.19216,
   "text": "他说他看见有人数错了，数到三"
  },
  {
   "start": 423.19216,
   "end": 425.8,
   "text": "人就软下去了，没出一点声音"
  },
  {
   "start": 425.8,
   "end": 430.225,
   "text": "你们对到天黑，把能想到的动作都过了一遍"
  },
  {
   "start": 430.225,
   "end": 431.7,
   "text": "还是没有答案"
  },
  {
   "start": 431.7,
   "end": 434.75146153846157,
   "text": "第三天，你们开始隔着门交换东西"
  },
  {
   "start": 434.75146153846157,
   "end": 437.367,
   "text": "先递水，再递吃的，最后换电池"
  },
  {
   "start": 437.367,
   "end": 440.63584615384616,
   "text": "他把两罐午餐肉从门缝底下推过来"
  },
  {
   "start": 440.63584615384616,
   "end": 443.033,
   "text": "罐身有凹痕，标签被水泡过"
  },
  {
   "start": 443.033,
   "end": 445.84982142857143,
   "text": "你把半袋面包和一瓶水推回去"
  },
  {
   "start": 445.84982142857143,
   "end": 449.1,
   "text": "瓶子卡了一下才过去，你用脚尖顶的"
  },
  {
   "start": 449.1,
   "end": 451.9345416666667,
   "text": "他问你怎么记得住那么多动作"
  },
  {
   "start": 451.9345416666667,
   "end": 454.333,
   "text": "你说记不住，所以才写下来"
  },
  {
   "start": 454.333,
   "end": 457.8097407407407,
   "text": "你把本子举到门边，一页一页翻给他听"
  },
  {
   "start": 457.8097407407407,
   "end": 460.2,
   "text": "他在那边跟着念，念得很慢"
  },
  {
   "start": 460.2,
   "end": 463.02485185185185,
   "text": "他学着做，第一天就划错了三道"
  },
  {
   "start": 463.02485185185185,
   "end": 466.067,
   "text": "其中一道在开关那行，他停了很久"
  },
  {
   "start": 466.067,
   "end": 469.633,
   "text": "这堵墙隔开了两个房间，敲上去是空的"
  },
  {
   "start": 469.633,
   "end": 472.90425,
   "text": "第四天，你们决定把中间那堵墙砸开"
  },
  {
   "start": 472.90425,
   "end": 474.867,
   "text": "把两个房间并成一间"
  },
  {
   "start": 474.867,
   "end": 477.7015416666667,
   "text": "那墙是轻质隔墙，敲上去空空的"
  },
  {
   "start": 477.7015416666667,
   "end": 480.1,
   "text": "回声很闷，墙皮上一层霉斑"
  },
  {
   "start": 480.1,
   "end": 483.1525833333334,
   "text": "他抡起锤子，砸了第一下，灰往下掉"
  },
  {
   "start": 483.1525833333334,
   "end": 485.333,
   "text": "露出里面的白粉和砖缝"
  },
  {
   "start": 485.333,
   "end": 487.30282608695654,
   "text": "第二下，墙皮裂开一块"
  },
  {
   "start": 487.30282608695654,
   "end": 490.367,
   "text": "里面的灰浆已经酥了，一碰就掉渣"
  },
  {
   "start": 490.367,
   "end": 493.20000000000005,
   "text": "第三下，他的胳膊已经抡起来了"
  },
  {
   "start": 493.20000000000005,
   "end": 496.033,
   "text": "锤子举到最高点，你隔着门看见"
  },
  {
   "start": 496.033,
   "end": 498.6594347826087,
   "text": "你隔着门大喊：换手！声音劈了"
  },
  {
   "start": 498.6594347826087,
   "end": 501.067,
   "text": "最后一个字几乎没喊出来"
  },
  {
   "start": 501.067,
   "end": 504.10948,
   "text": "锤子停在半空，他整个人僵在那儿"
  },
  {
   "start": 504.10948,
   "end": 506.5,
   "text": "胳膊还在抖，两三秒才放下"
  },
  {
   "start": 506.5,
   "end": 509.12591304347825,
   "text": "他才把锤子放下，坐在地上喘"
  },
  {
   "start": 509.12591304347825,
   "end": 511.533,
   "text": "后背靠着墙，一只手撑着地"
  },
  {
   "start": 511.533,
   "end": 514.1697272727273,
   "text": "你们重新分工：一人两锤，换手"
  },
  {
   "start": 514.1697272727273,
   "end": 516.367,
   "text": "换姿势，数错了就停一天"
  },
  {
   "start": 516.367,
   "end": 520.0716923076923,
   "text": "锤子从门缝递来递去，一天只能砸一小块"
  },
  {
   "start": 520.0716923076923,
   "end": 522.033,
   "text": "砸完要用布擦一遍柄"
  },
  {
   "start": 522.033,
   "end": 525.07604,
   "text": "砸到第二天下午，墙上开出一个洞"
  },
  {
   "start": 525.07604,
   "end": 527.467,
   "text": "边缘全是碎砖，地上堆着灰"
  },
  {
   "start": 527.467,
   "end": 529.85752,
   "text": "洞不大，侧着身子才能过去"
  },
  {
   "start": 529.85752,
   "end": 532.9,
   "text": "肩膀先过，头要低一点，不然会蹭到"
  },
  {
   "start": 532.9,
   "end": 536.3886666666667,
   "text": "你从他那边爬过去，第一次看见他的脸"
  },
  {
   "start": 536.3886666666667,
   "end": 538.133,
   "text": "灰扑扑的，胡子没刮"
  },
  {
   "start": 538.133,
   "end": 541.1760400000001,
   "text": "一个三十来岁的男人，左腿有旧伤"
  },
  {
   "start": 541.1760400000001,
   "end": 543.567,
   "text": "走路有点拖，裤腿下露着疤"
  },
  {
   "start": 543.567,
   "end": 546.1835,
   "text": "两个房间通了，东西堆在一起"
  },
  {
   "start": 546.1835,
   "end": 548.8,
   "text": "空间大了一倍，风也能穿过去"
  },
  {
   "start": 548.8,
   "end": 552.2668571428571,
   "text": "你们把两张床并到一起，中间留出走道"
  },
  {
   "start": 552.2668571428571,
   "end": 554.867,
   "text": "一床被子叠得整齐，一床堆着"
  },
  {
   "start": 554.867,
   "end": 557.4820769230769,
   "text": "晚上你们轮流守夜，一个人睡"
  },
  {
   "start": 557.4820769230769,
   "end": 560.533,
   "text": "一个人听声，锤子放在中间的地上"
  },
  {
   "start": 560.533,
   "end": 564.2383461538462,
   "text": "他说他老婆在城南，出事那天电话就断了"
  },
  {
   "start": 564.2383461538462,
   "end": 566.2,
   "text": "打到第十几个关了机"
  },
  {
   "start": 566.2,
   "end": 569.2514615384615,
   "text": "你说你没什么人可找，父母在老家"
  },
  {
   "start": 569.2514615384615,
   "end": 571.867,
   "text": "太远，也说不清自己在等什么"
  },
  {
   "start": 571.867,
   "end": 574.5285925925925,
   "text": "那一晚你们都没怎么说话"
  },
  {
   "start": 574.5285925925925,
   "end": 578.4,
   "text": "只是把灯留得比平时久，久到灯泡发烫"
  },
  {
   "start": 578.4,
   "end": 580.733,
   "text": "第六天，墙上多了一张表"
  },
  {
   "start": 580.733,
   "end": 584.002423076923,
   "text": "第六天，你们定了一套流程，写在墙上"
  },
  {
   "start": 584.002423076923,
   "end": 586.4,
   "text": "写完两个人都退后一步看"
  },
  {
   "start": 586.4,
   "end": 589.2345416666667,
   "text": "吃饭分两次，先吃一半，放下筷子"
  },
  {
   "start": 589.2345416666667,
   "end": 591.633,
   "text": "换手再吃，筷子放在碗沿上"
  },
  {
   "start": 591.633,
   "end": 594.8934,
   "text": "开门分两步，先拉，再推，中间数一个数"
  },
  {
   "start": 594.8934,
   "end": 597.067,
   "text": "数完才许动，谁都不能抢"
  },
  {
   "start": 597.067,
   "end": 599.9015416666666,
   "text": "拧瓶盖左右手交替，拧两下就换"
  },
  {
   "start": 599.9015416666666,
   "end": 602.3,
   "text": "连往哪边转都要先想清楚"
  },
  {
   "start": 602.3,
   "end": 604.4731999999999,
   "text": "连刷牙都分成上下两段"
  },
  {
   "start": 604.4731999999999,
   "end": 607.733,
   "text": "中间漱一次口，牙刷换一次手，水要省"
  },
  {
   "start": 607.733,
   "end": 611.2223333333333,
   "text": "日子勉强稳定下来，你们甚至开始下棋"
  },
  {
   "start": 611.2223333333333,
   "end": 612.967,
   "text": "棋盘是用纸板画的"
  },
  {
   "start": 612.967,
   "end": 616.2268,
   "text": "棋子是瓶盖，红的白的，一个人用红的"
  },
  {
   "start": 616.2268,
   "end": 618.4,
   "text": "一个用白的，输的人洗碗"
  },
  {
   "start": 618.4,
   "end": 621.0165,
   "text": "第七天，你们发现水比想的快"
  },
  {
   "start": 621.0165,
   "end": 623.633,
   "text": "瓶子空得比饭快，一天少半瓶"
  },
  {
   "start": 623.633,
   "end": 626.6971739130435,
   "text": "四瓶水加他那边三瓶，只剩两瓶半"
  },
  {
   "start": 626.6971739130435,
   "end": 628.667,
   "text": "其中一瓶还只剩个底"
  },
  {
   "start": 628.667,
   "end": 631.2820769230769,
   "text": "按现在的喝法，最多再撑三天"
  },
  {
   "start": 631.2820769230769,
   "end": 634.333,
   "text": "第三天晚上就没有了，一口都不剩"
  },
  {
   "start": 634.333,
   "end": 637.8097407407407,
   "text": "楼下就是社区便利店，直线不到五十米"
  },
  {
   "start": 637.8097407407407,
   "end": 640.2,
   "text": "从窗户能看见歪掉的招牌"
  },
  {
   "start": 640.2,
   "end": 643.367,
   "text": "楼下五十米就是便利店，招牌歪着"
  },
  {
   "start": 643.367,
   "end": 645.9820769230769,
   "text": "可从这儿下去，要走三层楼梯"
  },
  {
   "start": 645.9820769230769,
   "end": 649.033,
   "text": "开三道防火门，每一道都可能卡住"
  },
  {
   "start": 649.033,
   "end": 650.99575,
   "text": "每一道门，每一级台阶"
  },
  {
   "start": 650.99575,
   "end": 654.267,
   "text": "都可能让你多数一次，或者少想一次"
  },
  {
   "start": 654.267,
   "end": 657.7537692307692,
   "text": "你们算了一整夜，把能省的动作全省了"
  },
  {
   "start": 657.7537692307692,
   "end": 659.933,
   "text": "连背包换肩都定了顺序"
  },
  {
   "start": 659.933,
   "end": 663.1934,
   "text": "第八天，你们决定出门，然后往城南走"
  },
  {
   "start": 663.1934,
   "end": 665.367,
   "text": "不再回来，屋子也不管了"
  },
  {
   "start": 665.367,
   "end": 668.4305652173913,
   "text": "城南有个大型避难所，广播里说过"
  },
  {
   "start": 668.4305652173913,
   "end": 670.4,
   "text": "在地图上被圈了三圈"
  },
  {
   "start": 670.4,
   "end": 673.4635652173913,
   "text": "你们在本子上画路线，一层一层标"
  },
  {
   "start": 673.4635652173913,
   "end": 675.433,
   "text": "标完再用红笔描一遍"
  },
  {
   "start": 675.433,
   "end": 678.47604,
   "text": "哪扇门先拉，哪扇门先推，谁走前面"
  },
  {
   "start": 678.47604,
   "end": 680.867,
   "text": "都写清楚，连停多久都写了"
  },
  {
   "start": 680.867,
   "end": 684.137625,
   "text": "每一段楼梯，都在旁边写上动作顺序"
  },
  {
   "start": 684.137625,
   "end": 686.1,
   "text": "写到三楼，纸就不够了"
  },
  {
   "start": 686.1,
   "end": 688.9335000000001,
   "text": "写完你们又对了一遍，改了三处"
  },
  {
   "start": 688.9335000000001,
   "end": 691.767,
   "text": "其中一处是门的开向，差点弄反"
  },
  {
   "start": 691.767,
   "end": 695.2441200000001,
   "text": "第九天，你们把要带的东西打成两个包"
  },
  {
   "start": 695.2441200000001,
   "end": 697.2,
   "text": "一人一个，重量差不多"
  },
  {
   "start": 697.2,
   "end": 699.5984583333334,
   "text": "锤子、铁棍、两瓶水、几包饼干"
  },
  {
   "start": 699.5984583333334,
   "end": 702.433,
   "text": "那个本子，本子放最贴身的口袋"
  },
  {
   "start": 702.433,
   "end": 705.2680833333334,
   "text": "晚上你睡不着，听着楼里的风声"
  },
  {
   "start": 705.2680833333334,
   "end": 707.667,
   "text": "风在楼道里绕，像在找出口"
  },
  {
   "start": 707.667,
   "end": 710.0716428571428,
   "text": "风从破掉的窗户里进来"
  },
  {
   "start": 710.0716428571428,
   "end": 714.4,
   "text": "像有人在很远的地方哭，哭一会儿停一会儿"
  },
  {
   "start": 714.4,
   "end": 717.22516,
   "text": "第十天早上六点，你们开门出去"
  },
  {
   "start": 717.22516,
   "end": 719.833,
   "text": "楼道里比想象中更黑，也更冷"
  },
  {
   "start": 719.833,
   "end": 722.4405555555555,
   "text": "应急灯一闪一闪，绿光贴着地"
  },
  {
   "start": 722.4405555555555,
   "end": 725.7,
   "text": "把台阶照成一片一片的，看清楚也难"
  },
  {
   "start": 725.7,
   "end": 728.0984583333334,
   "text": "地上有个人，趴在三楼拐角"
  },
  {
   "start": 728.0984583333334,
   "end": 730.933,
   "text": "手还搭在扶手上，鞋底朝着上面"
  },
  {
   "start": 730.933,
   "end": 733.9861666666667,
   "text": "你们从他旁边绕过去，谁都没说话"
  },
  {
   "start": 733.9861666666667,
   "end": 736.167,
   "text": "绕着走的时候都屏着气"
  },
  {
   "start": 736.167,
   "end": 739.425888888889,
   "text": "下到二楼，你看见楼梯上倒着三个人"
  },
  {
   "start": 739.425888888889,
   "end": 742.033,
   "text": "方向都是往下的，姿势不一样"
  },
  {
   "start": 742.033,
   "end": 745.5203846153846,
   "text": "有一个人的手机还亮着，停在拨号界面"
  },
  {
   "start": 745.5203846153846,
   "end": 747.7,
   "text": "三个数字亮着，没按下去"
  },
  {
   "start": 747.7,
   "end": 750.7635652173913,
   "text": "老陈说，他们都是下楼的时候乱了"
  },
  {
   "start": 750.7635652173913,
   "end": 752.733,
   "text": "脚一乱，手就跟着重复"
  },
  {
   "start": 752.733,
   "end": 755.3594347826087,
   "text": "下楼梯这个动作，重复了三次"
  },
  {
   "start": 755.3594347826087,
   "end": 757.767,
   "text": "就这么简单，没人提醒他们"
  },
  {
   "start": 757.767,
   "end": 759.9638181818182,
   "text": "你们开始报数，一声一声"
  },
  {
   "start": 759.9638181818182,
   "end": 762.6,
   "text": "压着嗓子，报完一个才走一步"
  },
  {
   "start": 762.6,
   "end": 765.0095238095239,
   "text": "第一次拉门，第二次换手拉"
  },
  {
   "start": 765.0095238095239,
   "end": 767.2,
   "text": "走，门轴响得像有人在叫"
  },
  {
   "start": 767.2,
   "end": 770.767,
   "text": "一楼的门厅比楼上更黑，柜子倒在门边"
  },
  {
   "start": 770.767,
   "end": 774.037625,
   "text": "到一楼，防火门被倒下的柜子卡住了"
  },
  {
   "start": 774.037625,
   "end": 776.0,
   "text": "柜角整个嵌进门缝里"
  },
  {
   "start": 776.0,
   "end": 778.82516,
   "text": "你用肩膀撞了一下，门只晃了晃"
  },
  {
   "start": 778.82516,
   "end": 781.433,
   "text": "柜子挪了不到一指，纹丝不动"
  },
  {
   "start": 781.433,
   "end": 784.91076,
   "text": "第二下，你退后半步，用整个身子撞上去"
  },
  {
   "start": 784.91076,
   "end": 786.867,
   "text": "脚在地上蹬出一道印"
  },
  {
   "start": 786.867,
   "end": 789.0401999999999,
   "text": "门缝开了一点，又弹回来"
  },
  {
   "start": 789.0401999999999,
   "end": 792.3,
   "text": "铁皮柜子发出很闷的一声，像有人咳"
  },
  {
   "start": 792.3,
   "end": 794.9361818181818,
   "text": "第三下，你的肩膀已经绷紧了"
  },
  {
   "start": 794.9361818181818,
   "end": 797.133,
   "text": "人往前倾，脚已经离了地"
  },
  {
   "start": 797.133,
   "end": 799.09575,
   "text": "半空中你硬生生刹住"
  },
  {
   "start": 799.09575,
   "end": 802.367,
   "text": "人往前晃了两步，一只手撑在门板上"
  },
  {
   "start": 802.367,
   "end": 804.5462307692308,
   "text": "老陈一把拽住你的胳膊"
  },
  {
   "start": 804.5462307692308,
   "end": 808.033,
   "text": "两个人靠在墙上，胸口起伏得像刚跑完"
  },
  {
   "start": 808.033,
   "end": 810.4405652173913,
   "text": "你们改用铁棍撬，一人两下"
  },
  {
   "start": 810.4405652173913,
   "end": 813.067,
   "text": "换手，棍子插进门缝，用身体压"
  },
  {
   "start": 813.067,
   "end": 815.89216,
   "text": "撬到第四次，门轴发出一声闷响"
  },
  {
   "start": 815.89216,
   "end": 818.5,
   "text": "铁锈崩开一小片，门往外错开"
  },
  {
   "start": 818.5,
   "end": 821.7594444444444,
   "text": "铁门开了，外面的光刺得你睁不开眼"
  },
  {
   "start": 821.7594444444444,
   "end": 824.367,
   "text": "你抬手挡在额前，站了一会儿"
  },
  {
   "start": 824.367,
   "end": 827.6166428571428,
   "text": "踏出楼门的时候，你们后背全湿透了"
  },
  {
   "start": 827.6166428571428,
   "end": 830.433,
   "text": "汗把衣服贴在身上，风一吹发凉"
  },
  {
   "start": 830.433,
   "end": 832.8319166666666,
   "text": "街上很安静，车横在路中间"
  },
  {
   "start": 832.8319166666666,
   "end": 835.667,
   "text": "落了一层灰，车门都开着，没人关"
  },
  {
   "start": 835.667,
   "end": 838.2929130434783,
   "text": "空气里有股铁锈味，还有点甜"
  },
  {
   "start": 838.2929130434783,
   "end": 840.7,
   "text": "你说不上来那是什么味道"
  },
  {
   "start": 840.7,
   "end": 843.74248,
   "text": "五十米的距离，你们走了快十分钟"
  },
  {
   "start": 843.74248,
   "end": 846.133,
   "text": "每走几步就停一下，听一听"
  },
  {
   "start": 846.133,
   "end": 849.7,
   "text": "便利店的门开着一条缝，玻璃碎了一地"
  },
  {
   "start": 849.7,
   "end": 852.7635652173913,
   "text": "便利店的门半开着，玻璃碎了一地"
  },
  {
   "start": 852.7635652173913,
   "end": 854.733,
   "text": "招牌歪着，还亮着半边"
  },
  {
   "start": 854.733,
   "end": 858.21076,
   "text": "你们先找水，一整箱矿泉水还在仓库里"
  },
  {
   "start": 858.21076,
   "end": 860.167,
   "text": "纸箱受潮，塌了一个角"
  },
  {
   "start": 860.167,
   "end": 862.77484,
   "text": "然后是罐头、饼干、电池、打火机"
  },
  {
   "start": 862.77484,
   "end": 865.6,
   "text": "能拿的都往包里塞，塞到拉不上"
  },
  {
   "start": 865.6,
   "end": 869.2875,
   "text": "老陈在收银台后面翻出一台收音机"
  },
  {
   "start": 869.2875,
   "end": 871.5,
   "text": "天线拉出来，断了一截"
  },
  {
   "start": 871.5,
   "end": 873.9070869565218,
   "text": "他拧了两下旋钮，换手，再拧"
  },
  {
   "start": 873.9070869565218,
   "end": 876.533,
   "text": "收音机发出一阵刺耳的杂音"
  },
  {
   "start": 876.533,
   "end": 879.5971739130434,
   "text": "沙沙声里，有人在一遍一遍念通知"
  },
  {
   "start": 879.5971739130434,
   "end": 881.567,
   "text": "念完停几秒，再念一遍"
  },
  {
   "start": 881.567,
   "end": 883.9835,
   "text": "城南避难所已经稳定运行"
  },
  {
   "start": 883.9835,
   "end": 886.4,
   "text": "物资充足，有电，有水，有医生"
  },
  {
   "start": 886.4,
   "end": 889.2248518518519,
   "text": "通知里说，里面的规则一样生效"
  },
  {
   "start": 889.2248518518519,
   "end": 892.267,
   "text": "谁都不能例外，谁都不能多按一下"
  },
  {
   "start": 892.267,
   "end": 894.6575200000001,
   "text": "但有专人研究破解的办法"
  },
  {
   "start": 894.6575200000001,
   "end": 897.7,
   "text": "让活着的人过去，从南边那条路走"
  },
  {
   "start": 897.7,
   "end": 900.7666666666667,
   "text": "你们坐在地上，把那句话听了三遍"
  },
  {
   "start": 900.7666666666667,
   "end": 902.3,
   "text": "谁都没有先开口"
  },
  {
   "start": 902.3,
   "end": 904.7070869565217,
   "text": "从便利店到避难所，三公里"
  },
  {
   "start": 904.7070869565217,
   "end": 907.333,
   "text": "中间隔着四个路口，五道铁门"
  },
  {
   "start": 907.333,
   "end": 909.9485384615384,
   "text": "中间要过四个路口，五道铁门"
  },
  {
   "start": 909.9485384615384,
   "end": 913.0,
   "text": "其中三道已经被人从里面锁上了"
  },
  {
   "start": 913.0,
   "end": 915.1968181818181,
   "text": "你们在店里休整了一天"
  },
  {
   "start": 915.1968181818181,
   "end": 917.833,
   "text": "把能带的都带上，水装得最多"
  },
  {
   "start": 917.833,
   "end": 920.6680833333334,
   "text": "第十一天晚上，老陈拆一个罐头"
  },
  {
   "start": 920.6680833333334,
   "end": 923.067,
   "text": "刀口一滑，血一下就出来了"
  },
  {
   "start": 923.067,
   "end": 924.8244545454545,
   "text": "铁皮划开他的右手"
  },
  {
   "start": 924.8244545454545,
   "end": 927.9,
   "text": "从虎口一直拉到手腕，伤口翻着白"
  },
  {
   "start": 927.9,
   "end": 930.5361818181818,
   "text": "血止不住，他用布条缠了三层"
  },
  {
   "start": 930.5361818181818,
   "end": 932.733,
   "text": "缠完手举着不敢放下来"
  },
  {
   "start": 932.733,
   "end": 935.77604,
   "text": "那只手使不上力，连罐头都捏不住"
  },
  {
   "start": 935.77604,
   "end": 938.167,
   "text": "罐头从手里滚到货架底下"
  },
  {
   "start": 938.167,
   "end": 940.5740869565218,
   "text": "他没说话，你也什么都没问"
  },
  {
   "start": 940.5740869565218,
   "end": 943.2,
   "text": "你把他那份活默默接了过来"
  },
  {
   "start": 943.2,
   "end": 944.9383703703704,
   "text": "你把路线图拿出来"
  },
  {
   "start": 944.9383703703704,
   "end": 949.067,
   "text": "把要发力的地方全划到自己名下，一处一处改"
  },
  {
   "start": 949.067,
   "end": 952.1305652173913,
   "text": "开门、撬门、搬东西、砸锁，一行一行改"
  },
  {
   "start": 952.1305652173913,
   "end": 954.1,
   "text": "改到最后纸上只剩你"
  },
  {
   "start": 954.1,
   "end": 956.9558636363637,
   "text": "他坐在旁边看着，说这样你太累"
  },
  {
   "start": 956.9558636363637,
   "end": 958.933,
   "text": "说他那只手还能凑合"
  },
  {
   "start": 958.933,
   "end": 963.133,
   "text": "你说没事，我还有两只手，还有两种姿势，够用了"
  },
  {
   "start": 963.133,
   "end": 966.1760400000001,
   "text": "那天夜里，他把那把锤子擦了一遍"
  },
  {
   "start": 966.1760400000001,
   "end": 968.567,
   "text": "擦得很慢，像在擦别的东西"
  },
  {
   "start": 968.567,
   "end": 970.3193809523809,
   "text": "擦到第二遍，他停住"
  },
  {
   "start": 970.3193809523809,
   "end": 973.167,
   "text": "把锤子放在你床边，锤柄朝着你"
  },
  {
   "start": 973.167,
   "end": 975.8031818181819,
   "text": "第十二天清晨，你们往城南走"
  },
  {
   "start": 975.8031818181819,
   "end": 978.0,
   "text": "路上没什么人，也没有风"
  },
  {
   "start": 978.0,
   "end": 981.9,
   "text": "路上开始有别人留下的痕迹，翻倒的自行车"
  },
  {
   "start": 981.9,
   "end": 984.5,
   "text": "一只鞋，还有干在墙上的手印"
  },
  {
   "start": 984.5,
   "end": 988.0149090909091,
   "text": "走了两个小时，你们到了最后一道铁门"
  },
  {
   "start": 988.0149090909091,
   "end": 989.333,
   "text": "门比想象中高"
  },
  {
   "start": 989.333,
   "end": 992.267,
   "text": "最后一道门横在路口，焊缝很粗"
  },
  {
   "start": 992.267,
   "end": 994.6654583333334,
   "text": "门是双开的，从外面焊死了"
  },
  {
   "start": 994.6654583333334,
   "end": 997.5,
   "text": "焊疤一道压着一道，焊渣还挂着"
  },
  {
   "start": 997.5,
   "end": 1000.1155384615384,
   "text": "焊缝很粗，中间挂着一把新锁"
  },
  {
   "start": 1000.1155384615384,
   "end": 1003.167,
   "text": "锁身亮得反光，跟周围的锈不一样"
  },
  {
   "start": 1003.167,
   "end": 1007.3078076923077,
   "text": "门后面是一条直路，路的尽头就是避难所"
  },
  {
   "start": 1007.3078076923077,
   "end": 1009.5,
   "text": "能看见那边楼上的灯"
  },
  {
   "start": 1009.5,
   "end": 1012.1285714285715,
   "text": "老陈用左手抡锤，砸了第一下"
  },
  {
   "start": 1012.1285714285715,
   "end": 1014.1,
   "text": "锤头擦着锁边滑过去"
  },
  {
   "start": 1014.1,
   "end": 1016.7259130434783,
   "text": "锁只响了一声，焊缝纹丝不动"
  },
  {
   "start": 1016.7259130434783,
   "end": 1019.133,
   "text": "门板都没震一下，锁还在晃"
  },
  {
   "start": 1019.133,
   "end": 1021.9894545454546,
   "text": "第二下，他咬着牙，锤子差点脱手"
  },
  {
   "start": 1021.9894545454546,
   "end": 1023.967,
   "text": "砸在门板上，声音发闷"
  },
  {
   "start": 1023.967,
   "end": 1027.00948,
   "text": "你接过锤子，换成正握，砸了第一下"
  },
  {
   "start": 1027.00948,
   "end": 1029.4,
   "text": "双手一起用力，肩膀跟着沉"
  },
  {
   "start": 1029.4,
   "end": 1031.7984583333334,
   "text": "锁歪了，焊缝裂开一道口子"
  },
  {
   "start": 1031.7984583333334,
   "end": 1034.633,
   "text": "一小片焊渣掉在地上，弹了一下"
  },
  {
   "start": 1034.633,
   "end": 1037.4665,
   "text": "你换成侧身，用锤背砸了第二下"
  },
  {
   "start": 1037.4665,
   "end": 1040.3,
   "text": "锁身凹进去一块，手臂青筋绷起"
  },
  {
   "start": 1040.3,
   "end": 1042.7070869565218,
   "text": "锁严重变形，再一下就能开"
  },
  {
   "start": 1042.7070869565218,
   "end": 1045.333,
   "text": "门缝里透进来一线更亮的光"
  },
  {
   "start": 1045.333,
   "end": 1047.5234761904762,
   "text": "你停住了，锤子举在半空"
  },
  {
   "start": 1047.5234761904762,
   "end": 1049.933,
   "text": "人没有动，耳朵往后压下去"
  },
  {
   "start": 1049.933,
   "end": 1052.1138333333333,
   "text": "正握算一次，侧身算一次"
  },
  {
   "start": 1052.1138333333333,
   "end": 1055.167,
   "text": "这把锁你已经砸了两次，两种姿势"
  },
  {
   "start": 1055.167,
   "end": 1057.357476190476,
   "text": "再砸下去，不管换哪只手"
  },
  {
   "start": 1057.357476190476,
   "end": 1059.767,
   "text": "都是第三次，都是这一把锁"
  },
  {
   "start": 1059.767,
   "end": 1064.167,
   "text": "老陈在旁边喊：换我来，我还有一次，我左手还能砸"
  },
  {
   "start": 1064.167,
   "end": 1067.4622272727272,
   "text": "他伸出左手，锤子在他手里抖得厉害"
  },
  {
   "start": 1067.4622272727272,
   "end": 1069.0,
   "text": "锤头一直往下坠"
  },
  {
   "start": 1069.0,
   "end": 1071.4165,
   "text": "你回头看了一眼门后的路"
  },
  {
   "start": 1071.4165,
   "end": 1073.833,
   "text": "路上有光，光里有灰尘在飘"
  },
  {
   "start": 1073.833,
   "end": 1075.1462173913044,
   "text": "又看了一眼他"
  },
  {
   "start": 1075.1462173913044,
   "end": 1078.867,
   "text": "他的脸被汗冲得一道一道的，眼睛是红的"
  },
  {
   "start": 1078.867,
   "end": 1081.4929130434782,
   "text": "你从他手里把锤子拿了回来"
  },
  {
   "start": 1081.4929130434782,
   "end": 1083.9,
   "text": "他没有松，你用力抽了一下"
  },
  {
   "start": 1083.9,
   "end": 1085.8714285714286,
   "text": "你抡起来，砸了第三下"
  },
  {
   "start": 1085.8714285714286,
   "end": 1088.5,
   "text": "锤头正落在锁梁上，声音很脆"
  },
  {
   "start": 1088.5,
   "end": 1090.4714285714285,
   "text": "咔哒一声，锁掉在地上"
  },
  {
   "start": 1090.4714285714285,
   "end": 1093.1,
   "text": "铁门应声开了，门轴转得很慢"
  },
  {
   "start": 1093.1,
   "end": 1095.0771363636363,
   "text": "锤子从你手里滑下去"
  },
  {
   "start": 1095.0771363636363,
   "end": 1097.933,
   "text": "你靠着门框坐倒，后背贴着铁皮"
  },
  {
   "start": 1097.933,
   "end": 1100.7894545454546,
   "text": "老陈跪下来想拉你，你摇了摇头"
  },
  {
   "start": 1100.7894545454546,
   "end": 1102.767,
   "text": "抬手把他推开了半臂"
  },
  {
   "start": 1102.767,
   "end": 1105.37484,
   "text": "你抬手指了指门里面，让他走"
  },
  {
   "start": 1105.37484,
   "end": 1108.2,
   "text": "手指没有力气，抬到一半就落下"
  },
  {
   "start": 1108.2,
   "end": 1111.4598,
   "text": "他站起来，跑了进去，跑几步回一次头"
  },
  {
   "start": 1111.4598,
   "end": 1113.633,
   "text": "第三次回头时摔了一跤"
  },
  {
   "start": 1113.633,
   "end": 1116.9289090909092,
   "text": "你靠在墙上，看着他的背影越来越小"
  },
  {
   "start": 1116.9289090909092,
   "end": 1118.467,
   "text": "最后变成一个点"
  },
  {
   "start": 1118.467,
   "end": 1122.1716923076924,
   "text": "你低头看自己的手，这只手做过无数件事"
  },
  {
   "start": 1122.1716923076924,
   "end": 1124.133,
   "text": "开过门，倒过水，砸过墙"
  },
  {
   "start": 1124.133,
   "end": 1126.5500000000002,
   "text": "最后一次，它停在了第三下"
  },
  {
   "start": 1126.5500000000002,
   "end": 1128.967,
   "text": "停在了一把锁上，停得很稳"
  },
  {
   "start": 1128.967,
   "end": 1132.0086296296297,
   "text": "铁门后面的路上，太阳刚刚升起来"
  },
  {
   "start": 1132.0086296296297,
   "end": 1134.833,
   "text": "把整条街照成一种很浅的颜色"
  },
  {
   "start": 1134.833,
   "end": 1137.0138333333334,
   "text": "你没有再动，也没有再数"
  },
  {
   "start": 1137.0138333333334,
   "end": 1140.067,
   "text": "风从门缝里过来，吹动了你的领口"
  },
  {
   "start": 1140.067,
   "end": 1141.8113333333333,
   "text": "后来避难所的人说"
  },
  {
   "start": 1141.8113333333333,
   "end": 1145.3,
   "text": "那天早上他们开了一次门，门外没有人"
  },
  {
   "start": 1145.3,
   "end": 1148.7886666666666,
   "text": "门口没有人，只有一把锤子和一把断锁"
  },
  {
   "start": 1148.7886666666666,
   "end": 1150.533,
   "text": "锁梁上缺了一个口"
  },
  {
   "start": 1150.533,
   "end": 1153.3680833333333,
   "text": "他们说，铁门是从外面被砸开的"
  },
  {
   "start": 1153.3680833333333,
   "end": 1155.767,
   "text": "砸的人力气不小，砸了三下"
  },
  {
   "start": 1155.767,
   "end": 1158.1740869565217,
   "text": "没有人知道砸门的人是谁"
  },
  {
   "start": 1158.1740869565217,
   "end": 1160.8,
   "text": "也没有人问，门后来一直开着"
  },
  {
   "start": 1160.8,
   "end": 1164.0823913043478,
   "text": "我们一辈子都在重复做着同样的事"
  },
  {
   "start": 1164.0823913043478,
   "end": 1165.833,
   "text": "开门，喝水，按下开关"
  },
  {
   "start": 1165.833,
   "end": 1169.233,
   "text": "直到有一天，重复，变成了死罪"
  }
 ],
 "max_chars": 20
}