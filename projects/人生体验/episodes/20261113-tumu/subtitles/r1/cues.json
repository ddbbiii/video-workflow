{
 "cues": [
  {
   "start": 0.0,
   "end": 3.573,
   "text": "你高考考得不错，比平时高了三十多分"
  },
  {
   "start": 3.573,
   "end": 6.521,
   "text": "于是你奖励自己一个土木工程"
  },
  {
   "start": 6.521,
   "end": 10.094,
   "text": "你以为毕业就能进国企，当上项目经理"
  },
  {
   "start": 10.094,
   "end": 14.084,
   "text": "没想到命运的齿轮，来自一台混凝土搅拌机"
  },
  {
   "start": 14.084,
   "end": 17.241,
   "text": "家里开了个会，讨论你以后干什么"
  },
  {
   "start": 17.241,
   "end": 20.814,
   "text": "你没意见，只想报一个听起来稳的专业"
  },
  {
   "start": 20.814,
   "end": 24.804,
   "text": "表格下方有一栏叫服从调剂，你顺手打了勾"
  },
  {
   "start": 24.804,
   "end": 28.794,
   "text": "二舅说土木好，进了工程局就是国企，铁饭碗"
  },
  {
   "start": 28.794,
   "end": 32.367,
   "text": "三婶说，工装发下来，一年省好几身衣服"
  },
  {
   "start": 32.367,
   "end": 36.565,
   "text": "你爸把那张纸举到灯下，说这名字听着就结实"
  },
  {
   "start": 36.565,
   "end": 39.513,
   "text": "招生简章上印着一座跨海大桥"
  },
  {
   "start": 39.513,
   "end": 43.711,
   "text": "你在志愿表上填了土木工程，四个字，填得很快"
  },
  {
   "start": 43.711,
   "end": 47.284,
   "text": "那个暑假你看工地视频，觉得塔吊很帅"
  },
  {
   "start": 47.284,
   "end": 51.691,
   "text": "你还提前记下三总五项：三年总工，五年项目经理"
  },
  {
   "start": 51.691,
   "end": 55.716,
   "text": "你画了张时间表，二十八岁开越野车"
  },
  {
   "start": 55.716,
   "end": 59.706,
   "text": "开学第一天点名，全班四十六个人，四个女生"
  },
  {
   "start": 59.706,
   "end": 62.029,
   "text": "你安慰自己，比例不重要"
  },
  {
   "start": 62.029,
   "end": 66.227,
   "text": "第一学期理论力学，期中考试你考了五十二分"
  },
  {
   "start": 66.227,
   "end": 69.175,
   "text": "老师说，这个分数属于正常水平"
  },
  {
   "start": 69.175,
   "end": 73.165,
   "text": "你在宿舍墙上贴了张力学公式表，贴了四年"
  },
  {
   "start": 73.165,
   "end": 76.738,
   "text": "材料力学，你学会了画剪力图和弯矩图"
  },
  {
   "start": 76.738,
   "end": 80.311,
   "text": "结构力学，你开始怀疑自己的高中物理"
  },
  {
   "start": 80.311,
   "end": 83.468,
   "text": "土力学，老师说土是很复杂的材料"
  },
  {
   "start": 83.468,
   "end": 87.25,
   "text": "还有混凝土结构设计，和一门CAD制图"
  },
  {
   "start": 87.25,
   "end": 91.032,
   "text": "CAD作业画楼梯详图，六小时，比例错了"
  },
  {
   "start": 91.032,
   "end": 93.772,
   "text": "四年学的课，你只记住一句话"
  },
  {
   "start": 93.772,
   "end": 95.887,
   "text": "他说，力学不会背叛你"
  },
  {
   "start": 95.887,
   "end": 99.669,
   "text": "大三暑假去工地实习，安全帽借的，有点大"
  },
  {
   "start": 99.669,
   "end": 103.867,
   "text": "你在门口拍张照发朋友圈：工地打卡，未来可期"
  },
  {
   "start": 103.867,
   "end": 107.024,
   "text": "二舅点了赞，还评论了三个大拇指"
  },
  {
   "start": 107.024,
   "end": 108.99304347826087,
   "text": "那几天有人劝退土木"
  },
  {
   "start": 108.99304347826087,
   "end": 112.056,
   "text": "你在下面回了句：吃不了苦就直说"
  },
  {
   "start": 112.056,
   "end": 114.796,
   "text": "你把这句话截图存进了相册"
  },
  {
   "start": 114.796,
   "end": 118.821,
   "text": "那年你觉得，劝退的人只是不够努力"
  },
  {
   "start": 118.821,
   "end": 121.769,
   "text": "大四秋招，你准备了三十份简历"
  },
  {
   "start": 121.769,
   "end": 125.759,
   "text": "设计院的门槛写着研究生，地产公司在缩编"
  },
  {
   "start": 125.759,
   "end": 129.541,
   "text": "你投了三十家，收到三个面试，两个无领导"
  },
  {
   "start": 129.541,
   "end": 133.114,
   "text": "面试官问你为什么选土木，你说因为稳"
  },
  {
   "start": 133.114,
   "end": 135.854,
   "text": "他不笑了，把简历翻到第二页"
  },
  {
   "start": 135.854,
   "end": 138.04627272727274,
   "text": "十月底你签了中X某局"
  },
  {
   "start": 138.04627272727274,
   "end": 140.677,
   "text": "三方协议上那个章红得很正"
  },
  {
   "start": 140.677,
   "end": 144.667,
   "text": "签约那天你发了朋友圈，配图是协议的一角"
  },
  {
   "start": 144.667,
   "end": 148.24,
   "text": "你在宿舍楼下站了很久，觉得人生稳了"
  },
  {
   "start": 148.24,
   "end": 151.397,
   "text": "总部在市区，楼很高，前台摆着绿植"
  },
  {
   "start": 151.397,
   "end": 154.554,
   "text": "公司订了酒店，早餐自助，还有培训"
  },
  {
   "start": 154.554,
   "end": 157.502,
   "text": "培训最后一天，你学会了唱司歌"
  },
  {
   "start": 157.502,
   "end": 160.45,
   "text": "第四天，分配名单贴在公告栏上"
  },
  {
   "start": 160.45,
   "end": 163.66721739130435,
   "text": "你的名字后面跟着一个项目部"
  },
  {
   "start": 163.66721739130435,
   "end": 166.142,
   "text": "离最近的镇二十三公里"
  },
  {
   "start": 166.142,
   "end": 170.132,
   "text": "项目部是两排蓝色板房，铁皮顶，夏天像烤箱"
  },
  {
   "start": 170.132,
   "end": 173.914,
   "text": "板房的空调是坏的，晚上十点以后才有水"
  },
  {
   "start": 173.914,
   "end": 177.487,
   "text": "你的第一个班，是凌晨四点的测量放线"
  },
  {
   "start": 177.487,
   "end": 181.269,
   "text": "你打着手电扶棱镜，风把图纸吹进了沟里"
  },
  {
   "start": 181.269,
   "end": 185.467,
   "text": "白天在太阳底下站八小时，安全帽里能倒出汗"
  },
  {
   "start": 185.467,
   "end": 189.04,
   "text": "晚上八点别人下班，你开始写施工日志"
  },
  {
   "start": 189.04,
   "end": 193.238,
   "text": "日志上永远三行：今日完成，明日计划，材料进场"
  },
  {
   "start": 193.238,
   "end": 195.978,
   "text": "写到第十天，三行每天都一样"
  },
  {
   "start": 195.978,
   "end": 199.76,
   "text": "工地上的日子按浇筑节点算，不按星期算"
  },
  {
   "start": 199.76,
   "end": 203.75,
   "text": "夜里十一点混凝土车到了，工长喊你去打灰"
  },
  {
   "start": 203.75,
   "end": 207.74,
   "text": "打灰就是浇筑混凝土，你得看着它流到天亮"
  },
  {
   "start": 207.74,
   "end": 211.938,
   "text": "天亮后你刷朋友圈，同学在写代码，一个在考公"
  },
  {
   "start": 211.938,
   "end": 215.928,
   "text": "你低头看手上的水泥浆，觉得自己有点天赋"
  },
  {
   "start": 215.928,
   "end": 219.085,
   "text": "室友说这不是天赋，这是打灰圣体"
  },
  {
   "start": 219.085,
   "end": 221.617,
   "text": "你觉得这话挺对，还挺高兴"
  },
  {
   "start": 221.617,
   "end": 225.399,
   "text": "半年后回家，亲戚问你当上项目经理没有"
  },
  {
   "start": 225.399,
   "end": 228.382,
   "text": "你说快了，还差两年总工"
  },
  {
   "start": 228.382,
   "end": 231.33,
   "text": "项目部每周五聚餐，白酒是标配"
  },
  {
   "start": 231.33,
   "end": 234.903,
   "text": "你第一次上桌，被安排在最靠门的位置"
  },
  {
   "start": 234.903,
   "end": 237.851,
   "text": "领导举杯，说这杯敬你们新来的"
  },
  {
   "start": 237.851,
   "end": 241.633,
   "text": "你还没反应过来，旁边的人用胳膊肘碰你"
  },
  {
   "start": 241.633,
   "end": 244.373,
   "text": "你喝了，喉咙里像烧了一条路"
  },
  {
   "start": 244.373,
   "end": 248.363,
   "text": "第二轮要挨个敬，从左边开始，杯子得低一点"
  },
  {
   "start": 248.363,
   "end": 251.936,
   "text": "你说错一句话，把「我干了」说成了「我随意」"
  },
  {
   "start": 251.936,
   "end": 255.301,
   "text": "桌上安静了两秒，然后大家一起笑了"
  },
  {
   "start": 255.301,
   "end": 259.083,
   "text": "吃完饭有人提议去洗脚，你说你脚挺好的"
  },
  {
   "start": 259.083,
   "end": 262.865,
   "text": "那天晚上你一个人在院子里坐到十二点"
  },
  {
   "start": 262.865,
   "end": 266.647,
   "text": "你的同学分散在七个省，最远那个在高原"
  },
  {
   "start": 266.647,
   "end": 269.0585,
   "text": "女朋友上一条消息三天前"
  },
  {
   "start": 269.0585,
   "end": 271.47,
   "text": "问你那边信号是不是不好"
  },
  {
   "start": 271.47,
   "end": 274.453,
   "text": "你想了很久，回了一个字"
  },
  {
   "start": 274.453,
   "end": 277.193,
   "text": "第二年冬天，你刷到一个帖子"
  },
  {
   "start": 277.193,
   "end": 280.975,
   "text": "发帖的是个大三学生，正在反驳劝退的人"
  },
  {
   "start": 280.975,
   "end": 284.548,
   "text": "他说你们只看到现在，看不到五年以后"
  },
  {
   "start": 284.548,
   "end": 288.538,
   "text": "他说三总五项，是这个行业给年轻人的承诺"
  },
  {
   "start": 288.538,
   "end": 292.528,
   "text": "这条帖子后来被人截图存下来，叫土木圣经"
  },
  {
   "start": 292.528,
   "end": 295.476,
   "text": "你在屏幕前坐了很久，看了三遍"
  },
  {
   "start": 295.476,
   "end": 299.883,
   "text": "你翻出三年前存的那张截图，那时你也这么说话"
  },
  {
   "start": 299.883,
   "end": 302.831,
   "text": "你找到自己那条评论，点了删除"
  },
  {
   "start": 302.831,
   "end": 306.613,
   "text": "你在下面留了一行字：土木工程，垃圾专业"
  },
  {
   "start": 306.613,
   "end": 309.978,
   "text": "有人回你，说你就是被劝退的那种人"
  },
  {
   "start": 309.978,
   "end": 312.51,
   "text": "你没有回，你决定提桶跑路"
  },
  {
   "start": 312.51,
   "end": 316.708,
   "text": "第二天你去镇上买了个红色塑料桶，二十八块"
  },
  {
   "start": 316.708,
   "end": 320.073,
   "text": "红桶是工地最体面的行李，谁都认得"
  },
  {
   "start": 320.073,
   "end": 323.438,
   "text": "你提着桶走回项目部，路上遇见工长"
  },
  {
   "start": 323.438,
   "end": 327.011,
   "text": "他问你去干什么，你说收东西，明天就走"
  },
  {
   "start": 327.011,
   "end": 329.334,
   "text": "桶刚放在床边，手机响了"
  },
  {
   "start": 329.334,
   "end": 332.074,
   "text": "工长说，明天六点浇筑，别迟到"
  },
  {
   "start": 332.074,
   "end": 334.606,
   "text": "你把衣服又放回了柜子里"
  },
  {
   "start": 334.606,
   "end": 337.346,
   "text": "那天晚上下了雨，宿舍顶漏了"
  },
  {
   "start": 337.346,
   "end": 339.878,
   "text": "你把桶挪到了漏水的地方"
  },
  {
   "start": 339.878,
   "end": 342.618,
   "text": "桶接了一夜的水，声音很规律"
  },
  {
   "start": 342.618,
   "end": 344.941,
   "text": "你听着那个声音睡着了"
  },
  {
   "start": 344.941,
   "end": 348.966,
   "text": "第二天早上六点，你准时站在工地上"
  }
 ],
 "max_chars": 20
}