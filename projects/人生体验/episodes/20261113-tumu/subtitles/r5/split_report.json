{
 "source": "subtitles\\r5\\sentences.srt",
 "out": "subtitles\\r5\\body.srt",
 "max_chars": 20,
 "src_cues": 95,
 "out_cues": 99,
 "chars_min": 9,
 "chars_max": 20,
 "chars_mean": 14.94,
 "short_cues": [],
 "word_splits": [],
 "per_source": [
  {
   "index": "1",
   "source": "家里开了个会，讨论你以后干什么。",
   "source_chars": 14,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "2",
   "source": "你没意见，只想报一个听起来稳的专业。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "3",
   "source": "表格下方有一栏叫服从调剂，你顺手打了勾。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "4",
   "source": "二舅说土木好，进了工程局就是国企，铁饭碗。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "5",
   "source": "三婶说，工装发下来，一年省好几身衣服。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "6",
   "source": "你爸把那张纸举到灯下，说这名字听着就结实。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "7",
   "source": "招生简章上印着一座跨海大桥。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "8",
   "source": "你在志愿表上填了土木工程，四个字，填得很快。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "9",
   "source": "那个暑假你看工地视频，觉得塔吊很帅。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "10",
   "source": "你还提前记下三总五项：三年总工，五年项目经理。",
   "source_chars": 20,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "11",
   "source": "你画了张时间表，二十八岁开越野车。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "12",
   "source": "开学第一天点名，全班四十六个人，四个女生。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "13",
   "source": "你安慰自己，比例不重要。",
   "source_chars": 10,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "14",
   "source": "第一学期理论力学，期中考试你考了五十二分。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "15",
   "source": "老师说，这个分数属于正常水平。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "16",
   "source": "你在宿舍墙上贴了张力学公式表，贴了四年。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "17",
   "source": "材料力学，你学会了画剪力图和弯矩图。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "18",
   "source": "结构力学，你开始怀疑自己的高中物理。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "19",
   "source": "土力学，老师说土是很复杂的材料。",
   "source_chars": 14,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "20",
   "source": "还有混凝土结构设计，和一门CAD制图。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "21",
   "source": "CAD作业画楼梯详图，六小时，比例错了。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "22",
   "source": "四年学的课，你只记住一句话。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "23",
   "source": "他说，力学不会背叛你。",
   "source_chars": 9,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "24",
   "source": "大三暑假去工地实习，安全帽借的，有点大。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "25",
   "source": "你在门口拍张照发朋友圈：工地打卡，未来可期。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "26",
   "source": "二舅点了赞，还评论了三个大拇指。",
   "source_chars": 14,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "27",
   "source": "那几天有人劝退土木，你在下面回了句：吃不了苦就直说。",
   "source_chars": 23,
   "cues": 2,
   "word_split": []
  },
  {
   "index": "28",
   "source": "你把这句话截图存进了相册。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "29",
   "source": "那年你觉得，劝退的人只是不够努力。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "30",
   "source": "大四秋招，你准备了三十份简历。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "31",
   "source": "设计院的门槛写着研究生，地产公司在缩编。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "32",
   "source": "你投了三十家，收到三个面试，两个无领导。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "33",
   "source": "面试官问你为什么选土木，你说因为稳。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "34",
   "source": "他不笑了，把简历翻到第二页。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "35",
   "source": "十月底你签了中X某局，三方协议上那个章红得很正。",
   "source_chars": 22,
   "cues": 2,
   "word_split": []
  },
  {
   "index": "36",
   "source": "签约那天你发了朋友圈，配图是协议的一角。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "37",
   "source": "你在宿舍楼下站了很久，觉得人生稳了。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "38",
   "source": "总部在市区，楼很高，前台摆着绿植。",
   "source_chars": 14,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "39",
   "source": "公司订了酒店，早餐自助，还有培训。",
   "source_chars": 14,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "40",
   "source": "培训最后一天，你学会了唱司歌。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "41",
   "source": "第四天，分配名单贴在公告栏上。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "42",
   "source": "你的名字后面跟着一个项目部，离最近的镇二十三公里。",
   "source_chars": 23,
   "cues": 2,
   "word_split": []
  },
  {
   "index": "43",
   "source": "项目部是两排蓝色板房，铁皮顶，夏天像烤箱。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "44",
   "source": "板房的空调是坏的，晚上十点以后才有水。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "45",
   "source": "你的第一个班，是凌晨四点的测量放线。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "46",
   "source": "你打着手电扶棱镜，风把图纸吹进了沟里。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "47",
   "source": "白天在太阳底下站八小时，安全帽里能倒出汗。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "48",
   "source": "晚上八点别人下班，你开始写施工日志。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "49",
   "source": "日志上永远三行：今日完成，明日计划，材料进场。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "50",
   "source": "写到第十天，三行每天都一样。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "51",
   "source": "工地上的日子按浇筑节点算，不按星期算。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "52",
   "source": "夜里十一点混凝土车到了，工长喊你去打灰。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "53",
   "source": "打灰就是浇筑混凝土，你得看着它流到天亮。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "54",
   "source": "天亮后你刷朋友圈，同学在写代码，一个在考公。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "55",
   "source": "你低头看手上的水泥浆，觉得自己有点天赋。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "56",
   "source": "室友说这不是天赋，这是打灰圣体。",
   "source_chars": 14,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "57",
   "source": "你觉得这话挺对，还挺高兴。",
   "source_chars": 11,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "58",
   "source": "半年后回家，亲戚问你当上项目经理没有。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "59",
   "source": "你说快了，还差两年总工。",
   "source_chars": 10,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "60",
   "source": "项目部每周五聚餐，白酒是标配。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "61",
   "source": "你第一次上桌，被安排在最靠门的位置。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "62",
   "source": "领导举杯，说这杯敬你们新来的。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "63",
   "source": "你还没反应过来，旁边的人用胳膊肘碰你。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "64",
   "source": "你喝了，喉咙里像烧了一条路。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "65",
   "source": "第二轮要挨个敬，从左边开始，杯子得低一点。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "66",
   "source": "你说错一句话，把「我干了」说成了「我随意」。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "67",
   "source": "桌上安静了两秒，然后大家一起笑了。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "68",
   "source": "吃完饭有人提议去洗脚，你说你脚挺好的。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "69",
   "source": "那天晚上你一个人在院子里坐到十二点。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "70",
   "source": "你的同学分散在七个省，最远那个在高原。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "71",
   "source": "女朋友上一条消息三天前，问你那边信号是不是不好。",
   "source_chars": 22,
   "cues": 2,
   "word_split": []
  },
  {
   "index": "72",
   "source": "你想了很久，回了一个字。",
   "source_chars": 10,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "73",
   "source": "第二年冬天，你刷到一个帖子。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "74",
   "source": "发帖的是个大三学生，正在反驳劝退的人。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "75",
   "source": "他说你们只看到现在，看不到五年以后。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "76",
   "source": "他说三总五项，是这个行业给年轻人的承诺。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "77",
   "source": "这条帖子后来被人截图存下来，叫土木圣经。",
   "source_chars": 18,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "78",
   "source": "你在屏幕前坐了很久，看了三遍。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "79",
   "source": "你翻出三年前存的那张截图，那时你也这么说话。",
   "source_chars": 20,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "80",
   "source": "你找到自己那条评论，点了删除。",
   "source_chars": 13,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "81",
   "source": "你在下面留了一行字：土木工程，垃圾专业。",
   "source_chars": 17,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "82",
   "source": "有人回你，说你就是被劝退的那种人。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "83",
   "source": "你没有回，你决定提桶跑路。",
   "source_chars": 11,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "84",
   "source": "第二天你去镇上买了个红色塑料桶，二十八块。",
   "source_chars": 19,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "85",
   "source": "红桶是工地最体面的行李，谁都认得。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "86",
   "source": "你提着桶走回项目部，路上遇见工长。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "87",
   "source": "他问你去干什么，你说收东西，明天就走。",
   "source_chars": 16,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "88",
   "source": "桶刚放在床边，手机响了。",
   "source_chars": 10,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "89",
   "source": "工长说，明天六点浇筑，别迟到。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "90",
   "source": "你把衣服又放回了柜子里。",
   "source_chars": 11,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "91",
   "source": "那天晚上下了雨，宿舍顶漏了。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "92",
   "source": "你把桶挪到了漏水的地方。",
   "source_chars": 11,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "93",
   "source": "桶接了一夜的水，声音很规律。",
   "source_chars": 12,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "94",
   "source": "你听着那个声音睡着了。",
   "source_chars": 10,
   "cues": 1,
   "word_split": []
  },
  {
   "index": "95",
   "source": "第二天早上六点，你准时站在工地上。",
   "source_chars": 15,
   "cues": 1,
   "word_split": []
  }
 ]
}