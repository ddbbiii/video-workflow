{
 "cues": [
  {
   "start": 15.9,
   "end": 19.057,
   "text": "家里开了个会，讨论你以后干什么"
  },
  {
   "start": 19.057,
   "end": 22.63,
   "text": "你没意见，只想报一个听起来稳的专业"
  },
  {
   "start": 22.63,
   "end": 26.62,
   "text": "表格下方有一栏叫服从调剂，你顺手打了勾"
  },
  {
   "start": 26.62,
   "end": 30.61,
   "text": "二舅说土木好，进了工程局就是国企，铁饭碗"
  },
  {
   "start": 30.61,
   "end": 34.183,
   "text": "三婶说，工装发下来，一年省好几身衣服"
  },
  {
   "start": 34.183,
   "end": 38.381,
   "text": "你爸把那张纸举到灯下，说这名字听着就结实"
  },
  {
   "start": 38.381,
   "end": 41.329,
   "text": "招生简章上印着一座跨海大桥"
  },
  {
   "start": 41.329,
   "end": 45.527,
   "text": "你在志愿表上填了土木工程，四个字，填得很快"
  },
  {
   "start": 45.527,
   "end": 49.1,
   "text": "那个暑假你看工地视频，觉得塔吊很帅"
  },
  {
   "start": 49.1,
   "end": 53.507,
   "text": "你还提前记下三总五项：三年总工，五年项目经理"
  },
  {
   "start": 53.507,
   "end": 57.532,
   "text": "你画了张时间表，二十八岁开越野车"
  },
  {
   "start": 57.532,
   "end": 61.522,
   "text": "开学第一天点名，全班四十六个人，四个女生"
  },
  {
   "start": 61.522,
   "end": 63.845,
   "text": "你安慰自己，比例不重要"
  },
  {
   "start": 63.845,
   "end": 68.043,
   "text": "第一学期理论力学，期中考试你考了五十二分"
  },
  {
   "start": 68.043,
   "end": 70.991,
   "text": "老师说，这个分数属于正常水平"
  },
  {
   "start": 70.991,
   "end": 74.981,
   "text": "你在宿舍墙上贴了张力学公式表，贴了四年"
  },
  {
   "start": 74.981,
   "end": 78.554,
   "text": "材料力学，你学会了画剪力图和弯矩图"
  },
  {
   "start": 78.554,
   "end": 82.127,
   "text": "结构力学，你开始怀疑自己的高中物理"
  },
  {
   "start": 82.127,
   "end": 85.284,
   "text": "土力学，老师说土是很复杂的材料"
  },
  {
   "start": 85.284,
   "end": 89.066,
   "text": "还有混凝土结构设计，和一门CAD制图"
  },
  {
   "start": 89.066,
   "end": 92.848,
   "text": "CAD作业画楼梯详图，六小时，比例错了"
  },
  {
   "start": 92.848,
   "end": 95.588,
   "text": "四年学的课，你只记住一句话"
  },
  {
   "start": 95.588,
   "end": 97.703,
   "text": "他说，力学不会背叛你"
  },
  {
   "start": 97.703,
   "end": 101.485,
   "text": "大三暑假去工地实习，安全帽借的，有点大"
  },
  {
   "start": 101.485,
   "end": 105.683,
   "text": "你在门口拍张照发朋友圈：工地打卡，未来可期"
  },
  {
   "start": 105.683,
   "end": 108.84,
   "text": "二舅点了赞，还评论了三个大拇指"
  },
  {
   "start": 108.84,
   "end": 110.80904347826088,
   "text": "那几天有人劝退土木"
  },
  {
   "start": 110.80904347826088,
   "end": 113.872,
   "text": "你在下面回了句：吃不了苦就直说"
  },
  {
   "start": 113.872,
   "end": 116.612,
   "text": "你把这句话截图存进了相册"
  },
  {
   "start": 116.612,
   "end": 120.637,
   "text": "那年你觉得，劝退的人只是不够努力"
  },
  {
   "start": 120.637,
   "end": 123.585,
   "text": "大四秋招，你准备了三十份简历"
  },
  {
   "start": 123.585,
   "end": 127.575,
   "text": "设计院的门槛写着研究生，地产公司在缩编"
  },
  {
   "start": 127.575,
   "end": 131.357,
   "text": "你投了三十家，收到三个面试，两个无领导"
  },
  {
   "start": 131.357,
   "end": 134.93,
   "text": "面试官问你为什么选土木，你说因为稳"
  },
  {
   "start": 134.93,
   "end": 137.67,
   "text": "他不笑了，把简历翻到第二页"
  },
  {
   "start": 137.67,
   "end": 139.8622727272727,
   "text": "十月底你签了中X某局"
  },
  {
   "start": 139.8622727272727,
   "end": 142.493,
   "text": "三方协议上那个章红得很正"
  },
  {
   "start": 142.493,
   "end": 146.483,
   "text": "签约那天你发了朋友圈，配图是协议的一角"
  },
  {
   "start": 146.483,
   "end": 150.056,
   "text": "你在宿舍楼下站了很久，觉得人生稳了"
  },
  {
   "start": 150.056,
   "end": 153.213,
   "text": "总部在市区，楼很高，前台摆着绿植"
  },
  {
   "start": 153.213,
   "end": 156.37,
   "text": "公司订了酒店，早餐自助，还有培训"
  },
  {
   "start": 156.37,
   "end": 159.318,
   "text": "培训最后一天，你学会了唱司歌"
  },
  {
   "start": 159.318,
   "end": 162.266,
   "text": "第四天，分配名单贴在公告栏上"
  },
  {
   "start": 162.266,
   "end": 165.48321739130435,
   "text": "你的名字后面跟着一个项目部"
  },
  {
   "start": 165.48321739130435,
   "end": 167.958,
   "text": "离最近的镇二十三公里"
  },
  {
   "start": 167.958,
   "end": 171.948,
   "text": "项目部是两排蓝色板房，铁皮顶，夏天像烤箱"
  },
  {
   "start": 171.948,
   "end": 175.73,
   "text": "板房的空调是坏的，晚上十点以后才有水"
  },
  {
   "start": 175.73,
   "end": 179.303,
   "text": "你的第一个班，是凌晨四点的测量放线"
  },
  {
   "start": 179.303,
   "end": 183.085,
   "text": "你打着手电扶棱镜，风把图纸吹进了沟里"
  },
  {
   "start": 183.085,
   "end": 187.283,
   "text": "白天在太阳底下站八小时，安全帽里能倒出汗"
  },
  {
   "start": 187.283,
   "end": 190.856,
   "text": "晚上八点别人下班，你开始写施工日志"
  },
  {
   "start": 190.856,
   "end": 195.054,
   "text": "日志上永远三行：今日完成，明日计划，材料进场"
  },
  {
   "start": 195.054,
   "end": 197.794,
   "text": "写到第十天，三行每天都一样"
  },
  {
   "start": 197.794,
   "end": 201.576,
   "text": "工地上的日子按浇筑节点算，不按星期算"
  },
  {
   "start": 201.576,
   "end": 205.566,
   "text": "夜里十一点混凝土车到了，工长喊你去打灰"
  },
  {
   "start": 205.566,
   "end": 209.556,
   "text": "打灰就是浇筑混凝土，你得看着它流到天亮"
  },
  {
   "start": 209.556,
   "end": 213.754,
   "text": "天亮后你刷朋友圈，同学在写代码，一个在考公"
  },
  {
   "start": 213.754,
   "end": 217.744,
   "text": "你低头看手上的水泥浆，觉得自己有点天赋"
  },
  {
   "start": 217.744,
   "end": 220.901,
   "text": "室友说这不是天赋，这是打灰圣体"
  },
  {
   "start": 220.901,
   "end": 223.433,
   "text": "你觉得这话挺对，还挺高兴"
  },
  {
   "start": 223.433,
   "end": 227.215,
   "text": "半年后回家，亲戚问你当上项目经理没有"
  },
  {
   "start": 227.215,
   "end": 230.198,
   "text": "你说快了，还差两年总工"
  },
  {
   "start": 230.198,
   "end": 233.146,
   "text": "项目部每周五聚餐，白酒是标配"
  },
  {
   "start": 233.146,
   "end": 236.719,
   "text": "你第一次上桌，被安排在最靠门的位置"
  },
  {
   "start": 236.719,
   "end": 239.667,
   "text": "领导举杯，说这杯敬你们新来的"
  },
  {
   "start": 239.667,
   "end": 243.449,
   "text": "你还没反应过来，旁边的人用胳膊肘碰你"
  },
  {
   "start": 243.449,
   "end": 246.189,
   "text": "你喝了，喉咙里像烧了一条路"
  },
  {
   "start": 246.189,
   "end": 250.179,
   "text": "第二轮要挨个敬，从左边开始，杯子得低一点"
  },
  {
   "start": 250.179,
   "end": 253.752,
   "text": "你说错一句话，把「我干了」说成了「我随意」"
  },
  {
   "start": 253.752,
   "end": 257.117,
   "text": "桌上安静了两秒，然后大家一起笑了"
  },
  {
   "start": 257.117,
   "end": 260.899,
   "text": "吃完饭有人提议去洗脚，你说你脚挺好的"
  },
  {
   "start": 260.899,
   "end": 264.681,
   "text": "那天晚上你一个人在院子里坐到十二点"
  },
  {
   "start": 264.681,
   "end": 268.463,
   "text": "你的同学分散在七个省，最远那个在高原"
  },
  {
   "start": 268.463,
   "end": 270.8745,
   "text": "女朋友上一条消息三天前"
  },
  {
   "start": 270.8745,
   "end": 273.286,
   "text": "问你那边信号是不是不好"
  },
  {
   "start": 273.286,
   "end": 276.269,
   "text": "你想了很久，回了一个字"
  },
  {
   "start": 276.269,
   "end": 279.009,
   "text": "第二年冬天，你刷到一个帖子"
  },
  {
   "start": 279.009,
   "end": 282.791,
   "text": "发帖的是个大三学生，正在反驳劝退的人"
  },
  {
   "start": 282.791,
   "end": 286.364,
   "text": "他说你们只看到现在，看不到五年以后"
  },
  {
   "start": 286.364,
   "end": 290.354,
   "text": "他说三总五项，是这个行业给年轻人的承诺"
  },
  {
   "start": 290.354,
   "end": 294.344,
   "text": "这条帖子后来被人截图存下来，叫土木圣经"
  },
  {
   "start": 294.344,
   "end": 297.292,
   "text": "你在屏幕前坐了很久，看了三遍"
  },
  {
   "start": 297.292,
   "end": 301.699,
   "text": "你翻出三年前存的那张截图，那时你也这么说话"
  },
  {
   "start": 301.699,
   "end": 304.647,
   "text": "你找到自己那条评论，点了删除"
  },
  {
   "start": 304.647,
   "end": 308.429,
   "text": "你在下面留了一行字：土木工程，垃圾专业"
  },
  {
   "start": 308.429,
   "end": 311.794,
   "text": "有人回你，说你就是被劝退的那种人"
  },
  {
   "start": 311.794,
   "end": 314.326,
   "text": "你没有回，你决定提桶跑路"
  },
  {
   "start": 314.326,
   "end": 318.524,
   "text": "第二天你去镇上买了个红色塑料桶，二十八块"
  },
  {
   "start": 318.524,
   "end": 321.889,
   "text": "红桶是工地最体面的行李，谁都认得"
  },
  {
   "start": 321.889,
   "end": 325.254,
   "text": "你提着桶走回项目部，路上遇见工长"
  },
  {
   "start": 325.254,
   "end": 328.827,
   "text": "他问你去干什么，你说收东西，明天就走"
  },
  {
   "start": 328.827,
   "end": 331.15,
   "text": "桶刚放在床边，手机响了"
  },
  {
   "start": 331.15,
   "end": 333.89,
   "text": "工长说，明天六点浇筑，别迟到"
  },
  {
   "start": 333.89,
   "end": 336.422,
   "text": "你把衣服又放回了柜子里"
  },
  {
   "start": 336.422,
   "end": 339.162,
   "text": "那天晚上下了雨，宿舍顶漏了"
  },
  {
   "start": 339.162,
   "end": 341.694,
   "text": "你把桶挪到了漏水的地方"
  },
  {
   "start": 341.694,
   "end": 344.434,
   "text": "桶接了一夜的水，声音很规律"
  },
  {
   "start": 344.434,
   "end": 346.757,
   "text": "你听着那个声音睡着了"
  },
  {
   "start": 346.757,
   "end": 350.782,
   "text": "第二天早上六点，你准时站在工地上"
  }
 ],
 "max_chars": 20
}