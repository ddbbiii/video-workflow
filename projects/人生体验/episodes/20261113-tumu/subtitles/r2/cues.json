{
 "cues": [
  {
   "start": 8.1,
   "end": 11.048,
   "text": "于是你奖励自己一个土木工程"
  },
  {
   "start": 11.048,
   "end": 14.621,
   "text": "你以为毕业就能进国企，当上项目经理"
  },
  {
   "start": 14.621,
   "end": 18.611,
   "text": "没想到命运的齿轮，来自一台混凝土搅拌机"
  },
  {
   "start": 18.611,
   "end": 21.768,
   "text": "家里开了个会，讨论你以后干什么"
  },
  {
   "start": 21.768,
   "end": 25.341,
   "text": "你没意见，只想报一个听起来稳的专业"
  },
  {
   "start": 25.341,
   "end": 29.331,
   "text": "表格下方有一栏叫服从调剂，你顺手打了勾"
  },
  {
   "start": 29.331,
   "end": 33.321,
   "text": "二舅说土木好，进了工程局就是国企，铁饭碗"
  },
  {
   "start": 33.321,
   "end": 36.894,
   "text": "三婶说，工装发下来，一年省好几身衣服"
  },
  {
   "start": 36.894,
   "end": 41.092,
   "text": "你爸把那张纸举到灯下，说这名字听着就结实"
  },
  {
   "start": 41.092,
   "end": 44.04,
   "text": "招生简章上印着一座跨海大桥"
  },
  {
   "start": 44.04,
   "end": 48.238,
   "text": "你在志愿表上填了土木工程，四个字，填得很快"
  },
  {
   "start": 48.238,
   "end": 51.811,
   "text": "那个暑假你看工地视频，觉得塔吊很帅"
  },
  {
   "start": 51.811,
   "end": 56.218,
   "text": "你还提前记下三总五项：三年总工，五年项目经理"
  },
  {
   "start": 56.218,
   "end": 60.243,
   "text": "你画了张时间表，二十八岁开越野车"
  },
  {
   "start": 60.243,
   "end": 64.233,
   "text": "开学第一天点名，全班四十六个人，四个女生"
  },
  {
   "start": 64.233,
   "end": 66.556,
   "text": "你安慰自己，比例不重要"
  },
  {
   "start": 66.556,
   "end": 70.754,
   "text": "第一学期理论力学，期中考试你考了五十二分"
  },
  {
   "start": 70.754,
   "end": 73.702,
   "text": "老师说，这个分数属于正常水平"
  },
  {
   "start": 73.702,
   "end": 77.692,
   "text": "你在宿舍墙上贴了张力学公式表，贴了四年"
  },
  {
   "start": 77.692,
   "end": 81.265,
   "text": "材料力学，你学会了画剪力图和弯矩图"
  },
  {
   "start": 81.265,
   "end": 84.838,
   "text": "结构力学，你开始怀疑自己的高中物理"
  },
  {
   "start": 84.838,
   "end": 87.995,
   "text": "土力学，老师说土是很复杂的材料"
  },
  {
   "start": 87.995,
   "end": 91.777,
   "text": "还有混凝土结构设计，和一门CAD制图"
  },
  {
   "start": 91.777,
   "end": 95.559,
   "text": "CAD作业画楼梯详图，六小时，比例错了"
  },
  {
   "start": 95.559,
   "end": 98.299,
   "text": "四年学的课，你只记住一句话"
  },
  {
   "start": 98.299,
   "end": 100.414,
   "text": "他说，力学不会背叛你"
  },
  {
   "start": 100.414,
   "end": 104.196,
   "text": "大三暑假去工地实习，安全帽借的，有点大"
  },
  {
   "start": 104.196,
   "end": 108.394,
   "text": "你在门口拍张照发朋友圈：工地打卡，未来可期"
  },
  {
   "start": 108.394,
   "end": 111.551,
   "text": "二舅点了赞，还评论了三个大拇指"
  },
  {
   "start": 111.551,
   "end": 113.52004347826087,
   "text": "那几天有人劝退土木"
  },
  {
   "start": 113.52004347826087,
   "end": 116.583,
   "text": "你在下面回了句：吃不了苦就直说"
  },
  {
   "start": 116.583,
   "end": 119.323,
   "text": "你把这句话截图存进了相册"
  },
  {
   "start": 119.323,
   "end": 123.348,
   "text": "那年你觉得，劝退的人只是不够努力"
  },
  {
   "start": 123.348,
   "end": 126.296,
   "text": "大四秋招，你准备了三十份简历"
  },
  {
   "start": 126.296,
   "end": 130.286,
   "text": "设计院的门槛写着研究生，地产公司在缩编"
  },
  {
   "start": 130.286,
   "end": 134.068,
   "text": "你投了三十家，收到三个面试，两个无领导"
  },
  {
   "start": 134.068,
   "end": 137.641,
   "text": "面试官问你为什么选土木，你说因为稳"
  },
  {
   "start": 137.641,
   "end": 140.381,
   "text": "他不笑了，把简历翻到第二页"
  },
  {
   "start": 140.381,
   "end": 142.57327272727272,
   "text": "十月底你签了中X某局"
  },
  {
   "start": 142.57327272727272,
   "end": 145.204,
   "text": "三方协议上那个章红得很正"
  },
  {
   "start": 145.204,
   "end": 149.194,
   "text": "签约那天你发了朋友圈，配图是协议的一角"
  },
  {
   "start": 149.194,
   "end": 152.767,
   "text": "你在宿舍楼下站了很久，觉得人生稳了"
  },
  {
   "start": 152.767,
   "end": 155.924,
   "text": "总部在市区，楼很高，前台摆着绿植"
  },
  {
   "start": 155.924,
   "end": 159.081,
   "text": "公司订了酒店，早餐自助，还有培训"
  },
  {
   "start": 159.081,
   "end": 162.029,
   "text": "培训最后一天，你学会了唱司歌"
  },
  {
   "start": 162.029,
   "end": 164.977,
   "text": "第四天，分配名单贴在公告栏上"
  },
  {
   "start": 164.977,
   "end": 168.19421739130436,
   "text": "你的名字后面跟着一个项目部"
  },
  {
   "start": 168.19421739130436,
   "end": 170.669,
   "text": "离最近的镇二十三公里"
  },
  {
   "start": 170.669,
   "end": 174.659,
   "text": "项目部是两排蓝色板房，铁皮顶，夏天像烤箱"
  },
  {
   "start": 174.659,
   "end": 178.441,
   "text": "板房的空调是坏的，晚上十点以后才有水"
  },
  {
   "start": 178.441,
   "end": 182.014,
   "text": "你的第一个班，是凌晨四点的测量放线"
  },
  {
   "start": 182.014,
   "end": 185.796,
   "text": "你打着手电扶棱镜，风把图纸吹进了沟里"
  },
  {
   "start": 185.796,
   "end": 189.994,
   "text": "白天在太阳底下站八小时，安全帽里能倒出汗"
  },
  {
   "start": 189.994,
   "end": 193.567,
   "text": "晚上八点别人下班，你开始写施工日志"
  },
  {
   "start": 193.567,
   "end": 197.765,
   "text": "日志上永远三行：今日完成，明日计划，材料进场"
  },
  {
   "start": 197.765,
   "end": 200.505,
   "text": "写到第十天，三行每天都一样"
  },
  {
   "start": 200.505,
   "end": 204.287,
   "text": "工地上的日子按浇筑节点算，不按星期算"
  },
  {
   "start": 204.287,
   "end": 208.277,
   "text": "夜里十一点混凝土车到了，工长喊你去打灰"
  },
  {
   "start": 208.277,
   "end": 212.267,
   "text": "打灰就是浇筑混凝土，你得看着它流到天亮"
  },
  {
   "start": 212.267,
   "end": 216.465,
   "text": "天亮后你刷朋友圈，同学在写代码，一个在考公"
  },
  {
   "start": 216.465,
   "end": 220.455,
   "text": "你低头看手上的水泥浆，觉得自己有点天赋"
  },
  {
   "start": 220.455,
   "end": 223.612,
   "text": "室友说这不是天赋，这是打灰圣体"
  },
  {
   "start": 223.612,
   "end": 226.144,
   "text": "你觉得这话挺对，还挺高兴"
  },
  {
   "start": 226.144,
   "end": 229.926,
   "text": "半年后回家，亲戚问你当上项目经理没有"
  },
  {
   "start": 229.926,
   "end": 232.909,
   "text": "你说快了，还差两年总工"
  },
  {
   "start": 232.909,
   "end": 235.857,
   "text": "项目部每周五聚餐，白酒是标配"
  },
  {
   "start": 235.857,
   "end": 239.43,
   "text": "你第一次上桌，被安排在最靠门的位置"
  },
  {
   "start": 239.43,
   "end": 242.378,
   "text": "领导举杯，说这杯敬你们新来的"
  },
  {
   "start": 242.378,
   "end": 246.16,
   "text": "你还没反应过来，旁边的人用胳膊肘碰你"
  },
  {
   "start": 246.16,
   "end": 248.9,
   "text": "你喝了，喉咙里像烧了一条路"
  },
  {
   "start": 248.9,
   "end": 252.89,
   "text": "第二轮要挨个敬，从左边开始，杯子得低一点"
  },
  {
   "start": 252.89,
   "end": 256.463,
   "text": "你说错一句话，把「我干了」说成了「我随意」"
  },
  {
   "start": 256.463,
   "end": 259.828,
   "text": "桌上安静了两秒，然后大家一起笑了"
  },
  {
   "start": 259.828,
   "end": 263.61,
   "text": "吃完饭有人提议去洗脚，你说你脚挺好的"
  },
  {
   "start": 263.61,
   "end": 267.392,
   "text": "那天晚上你一个人在院子里坐到十二点"
  },
  {
   "start": 267.392,
   "end": 271.174,
   "text": "你的同学分散在七个省，最远那个在高原"
  },
  {
   "start": 271.174,
   "end": 273.5855,
   "text": "女朋友上一条消息三天前"
  },
  {
   "start": 273.5855,
   "end": 275.997,
   "text": "问你那边信号是不是不好"
  },
  {
   "start": 275.997,
   "end": 278.98,
   "text": "你想了很久，回了一个字"
  },
  {
   "start": 278.98,
   "end": 281.72,
   "text": "第二年冬天，你刷到一个帖子"
  },
  {
   "start": 281.72,
   "end": 285.502,
   "text": "发帖的是个大三学生，正在反驳劝退的人"
  },
  {
   "start": 285.502,
   "end": 289.075,
   "text": "他说你们只看到现在，看不到五年以后"
  },
  {
   "start": 289.075,
   "end": 293.065,
   "text": "他说三总五项，是这个行业给年轻人的承诺"
  },
  {
   "start": 293.065,
   "end": 297.055,
   "text": "这条帖子后来被人截图存下来，叫土木圣经"
  },
  {
   "start": 297.055,
   "end": 300.003,
   "text": "你在屏幕前坐了很久，看了三遍"
  },
  {
   "start": 300.003,
   "end": 304.41,
   "text": "你翻出三年前存的那张截图，那时你也这么说话"
  },
  {
   "start": 304.41,
   "end": 307.358,
   "text": "你找到自己那条评论，点了删除"
  },
  {
   "start": 307.358,
   "end": 311.14,
   "text": "你在下面留了一行字：土木工程，垃圾专业"
  },
  {
   "start": 311.14,
   "end": 314.505,
   "text": "有人回你，说你就是被劝退的那种人"
  },
  {
   "start": 314.505,
   "end": 317.037,
   "text": "你没有回，你决定提桶跑路"
  },
  {
   "start": 317.037,
   "end": 321.235,
   "text": "第二天你去镇上买了个红色塑料桶，二十八块"
  },
  {
   "start": 321.235,
   "end": 324.6,
   "text": "红桶是工地最体面的行李，谁都认得"
  },
  {
   "start": 324.6,
   "end": 327.965,
   "text": "你提着桶走回项目部，路上遇见工长"
  },
  {
   "start": 327.965,
   "end": 331.538,
   "text": "他问你去干什么，你说收东西，明天就走"
  },
  {
   "start": 331.538,
   "end": 333.861,
   "text": "桶刚放在床边，手机响了"
  },
  {
   "start": 333.861,
   "end": 336.601,
   "text": "工长说，明天六点浇筑，别迟到"
  },
  {
   "start": 336.601,
   "end": 339.133,
   "text": "你把衣服又放回了柜子里"
  },
  {
   "start": 339.133,
   "end": 341.873,
   "text": "那天晚上下了雨，宿舍顶漏了"
  },
  {
   "start": 341.873,
   "end": 344.405,
   "text": "你把桶挪到了漏水的地方"
  },
  {
   "start": 344.405,
   "end": 347.145,
   "text": "桶接了一夜的水，声音很规律"
  },
  {
   "start": 347.145,
   "end": 349.468,
   "text": "你听着那个声音睡着了"
  },
  {
   "start": 349.468,
   "end": 353.493,
   "text": "第二天早上六点，你准时站在工地上"
  }
 ],
 "max_chars": 20
}