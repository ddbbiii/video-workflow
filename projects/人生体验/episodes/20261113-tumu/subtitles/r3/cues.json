{
 "cues": [
  {
   "start": 12.6,
   "end": 15.757,
   "text": "家里开了个会，讨论你以后干什么"
  },
  {
   "start": 15.757,
   "end": 19.33,
   "text": "你没意见，只想报一个听起来稳的专业"
  },
  {
   "start": 19.33,
   "end": 23.32,
   "text": "表格下方有一栏叫服从调剂，你顺手打了勾"
  },
  {
   "start": 23.32,
   "end": 27.31,
   "text": "二舅说土木好，进了工程局就是国企，铁饭碗"
  },
  {
   "start": 27.31,
   "end": 30.883,
   "text": "三婶说，工装发下来，一年省好几身衣服"
  },
  {
   "start": 30.883,
   "end": 35.081,
   "text": "你爸把那张纸举到灯下，说这名字听着就结实"
  },
  {
   "start": 35.081,
   "end": 38.029,
   "text": "招生简章上印着一座跨海大桥"
  },
  {
   "start": 38.029,
   "end": 42.227,
   "text": "你在志愿表上填了土木工程，四个字，填得很快"
  },
  {
   "start": 42.227,
   "end": 45.8,
   "text": "那个暑假你看工地视频，觉得塔吊很帅"
  },
  {
   "start": 45.8,
   "end": 50.207,
   "text": "你还提前记下三总五项：三年总工，五年项目经理"
  },
  {
   "start": 50.207,
   "end": 54.232,
   "text": "你画了张时间表，二十八岁开越野车"
  },
  {
   "start": 54.232,
   "end": 58.222,
   "text": "开学第一天点名，全班四十六个人，四个女生"
  },
  {
   "start": 58.222,
   "end": 60.545,
   "text": "你安慰自己，比例不重要"
  },
  {
   "start": 60.545,
   "end": 64.743,
   "text": "第一学期理论力学，期中考试你考了五十二分"
  },
  {
   "start": 64.743,
   "end": 67.691,
   "text": "老师说，这个分数属于正常水平"
  },
  {
   "start": 67.691,
   "end": 71.681,
   "text": "你在宿舍墙上贴了张力学公式表，贴了四年"
  },
  {
   "start": 71.681,
   "end": 75.254,
   "text": "材料力学，你学会了画剪力图和弯矩图"
  },
  {
   "start": 75.254,
   "end": 78.827,
   "text": "结构力学，你开始怀疑自己的高中物理"
  },
  {
   "start": 78.827,
   "end": 81.984,
   "text": "土力学，老师说土是很复杂的材料"
  },
  {
   "start": 81.984,
   "end": 85.766,
   "text": "还有混凝土结构设计，和一门CAD制图"
  },
  {
   "start": 85.766,
   "end": 89.548,
   "text": "CAD作业画楼梯详图，六小时，比例错了"
  },
  {
   "start": 89.548,
   "end": 92.288,
   "text": "四年学的课，你只记住一句话"
  },
  {
   "start": 92.288,
   "end": 94.403,
   "text": "他说，力学不会背叛你"
  },
  {
   "start": 94.403,
   "end": 98.185,
   "text": "大三暑假去工地实习，安全帽借的，有点大"
  },
  {
   "start": 98.185,
   "end": 102.383,
   "text": "你在门口拍张照发朋友圈：工地打卡，未来可期"
  },
  {
   "start": 102.383,
   "end": 105.54,
   "text": "二舅点了赞，还评论了三个大拇指"
  },
  {
   "start": 105.54,
   "end": 107.50904347826088,
   "text": "那几天有人劝退土木"
  },
  {
   "start": 107.50904347826088,
   "end": 110.572,
   "text": "你在下面回了句：吃不了苦就直说"
  },
  {
   "start": 110.572,
   "end": 113.312,
   "text": "你把这句话截图存进了相册"
  },
  {
   "start": 113.312,
   "end": 117.337,
   "text": "那年你觉得，劝退的人只是不够努力"
  },
  {
   "start": 117.337,
   "end": 120.285,
   "text": "大四秋招，你准备了三十份简历"
  },
  {
   "start": 120.285,
   "end": 124.275,
   "text": "设计院的门槛写着研究生，地产公司在缩编"
  },
  {
   "start": 124.275,
   "end": 128.057,
   "text": "你投了三十家，收到三个面试，两个无领导"
  },
  {
   "start": 128.057,
   "end": 131.63,
   "text": "面试官问你为什么选土木，你说因为稳"
  },
  {
   "start": 131.63,
   "end": 134.37,
   "text": "他不笑了，把简历翻到第二页"
  },
  {
   "start": 134.37,
   "end": 136.56227272727273,
   "text": "十月底你签了中X某局"
  },
  {
   "start": 136.56227272727273,
   "end": 139.193,
   "text": "三方协议上那个章红得很正"
  },
  {
   "start": 139.193,
   "end": 143.183,
   "text": "签约那天你发了朋友圈，配图是协议的一角"
  },
  {
   "start": 143.183,
   "end": 146.756,
   "text": "你在宿舍楼下站了很久，觉得人生稳了"
  },
  {
   "start": 146.756,
   "end": 149.913,
   "text": "总部在市区，楼很高，前台摆着绿植"
  },
  {
   "start": 149.913,
   "end": 153.07,
   "text": "公司订了酒店，早餐自助，还有培训"
  },
  {
   "start": 153.07,
   "end": 156.018,
   "text": "培训最后一天，你学会了唱司歌"
  },
  {
   "start": 156.018,
   "end": 158.966,
   "text": "第四天，分配名单贴在公告栏上"
  },
  {
   "start": 158.966,
   "end": 162.18321739130434,
   "text": "你的名字后面跟着一个项目部"
  },
  {
   "start": 162.18321739130434,
   "end": 164.658,
   "text": "离最近的镇二十三公里"
  },
  {
   "start": 164.658,
   "end": 168.648,
   "text": "项目部是两排蓝色板房，铁皮顶，夏天像烤箱"
  },
  {
   "start": 168.648,
   "end": 172.43,
   "text": "板房的空调是坏的，晚上十点以后才有水"
  },
  {
   "start": 172.43,
   "end": 176.003,
   "text": "你的第一个班，是凌晨四点的测量放线"
  },
  {
   "start": 176.003,
   "end": 179.785,
   "text": "你打着手电扶棱镜，风把图纸吹进了沟里"
  },
  {
   "start": 179.785,
   "end": 183.983,
   "text": "白天在太阳底下站八小时，安全帽里能倒出汗"
  },
  {
   "start": 183.983,
   "end": 187.556,
   "text": "晚上八点别人下班，你开始写施工日志"
  },
  {
   "start": 187.556,
   "end": 191.754,
   "text": "日志上永远三行：今日完成，明日计划，材料进场"
  },
  {
   "start": 191.754,
   "end": 194.494,
   "text": "写到第十天，三行每天都一样"
  },
  {
   "start": 194.494,
   "end": 198.276,
   "text": "工地上的日子按浇筑节点算，不按星期算"
  },
  {
   "start": 198.276,
   "end": 202.266,
   "text": "夜里十一点混凝土车到了，工长喊你去打灰"
  },
  {
   "start": 202.266,
   "end": 206.256,
   "text": "打灰就是浇筑混凝土，你得看着它流到天亮"
  },
  {
   "start": 206.256,
   "end": 210.454,
   "text": "天亮后你刷朋友圈，同学在写代码，一个在考公"
  },
  {
   "start": 210.454,
   "end": 214.444,
   "text": "你低头看手上的水泥浆，觉得自己有点天赋"
  },
  {
   "start": 214.444,
   "end": 217.601,
   "text": "室友说这不是天赋，这是打灰圣体"
  },
  {
   "start": 217.601,
   "end": 220.133,
   "text": "你觉得这话挺对，还挺高兴"
  },
  {
   "start": 220.133,
   "end": 223.915,
   "text": "半年后回家，亲戚问你当上项目经理没有"
  },
  {
   "start": 223.915,
   "end": 226.898,
   "text": "你说快了，还差两年总工"
  },
  {
   "start": 226.898,
   "end": 229.846,
   "text": "项目部每周五聚餐，白酒是标配"
  },
  {
   "start": 229.846,
   "end": 233.419,
   "text": "你第一次上桌，被安排在最靠门的位置"
  },
  {
   "start": 233.419,
   "end": 236.367,
   "text": "领导举杯，说这杯敬你们新来的"
  },
  {
   "start": 236.367,
   "end": 240.149,
   "text": "你还没反应过来，旁边的人用胳膊肘碰你"
  },
  {
   "start": 240.149,
   "end": 242.889,
   "text": "你喝了，喉咙里像烧了一条路"
  },
  {
   "start": 242.889,
   "end": 246.879,
   "text": "第二轮要挨个敬，从左边开始，杯子得低一点"
  },
  {
   "start": 246.879,
   "end": 250.452,
   "text": "你说错一句话，把「我干了」说成了「我随意」"
  },
  {
   "start": 250.452,
   "end": 253.817,
   "text": "桌上安静了两秒，然后大家一起笑了"
  },
  {
   "start": 253.817,
   "end": 257.599,
   "text": "吃完饭有人提议去洗脚，你说你脚挺好的"
  },
  {
   "start": 257.599,
   "end": 261.381,
   "text": "那天晚上你一个人在院子里坐到十二点"
  },
  {
   "start": 261.381,
   "end": 265.163,
   "text": "你的同学分散在七个省，最远那个在高原"
  },
  {
   "start": 265.163,
   "end": 267.5745,
   "text": "女朋友上一条消息三天前"
  },
  {
   "start": 267.5745,
   "end": 269.986,
   "text": "问你那边信号是不是不好"
  },
  {
   "start": 269.986,
   "end": 272.969,
   "text": "你想了很久，回了一个字"
  },
  {
   "start": 272.969,
   "end": 275.709,
   "text": "第二年冬天，你刷到一个帖子"
  },
  {
   "start": 275.709,
   "end": 279.491,
   "text": "发帖的是个大三学生，正在反驳劝退的人"
  },
  {
   "start": 279.491,
   "end": 283.064,
   "text": "他说你们只看到现在，看不到五年以后"
  },
  {
   "start": 283.064,
   "end": 287.054,
   "text": "他说三总五项，是这个行业给年轻人的承诺"
  },
  {
   "start": 287.054,
   "end": 291.044,
   "text": "这条帖子后来被人截图存下来，叫土木圣经"
  },
  {
   "start": 291.044,
   "end": 293.992,
   "text": "你在屏幕前坐了很久，看了三遍"
  },
  {
   "start": 293.992,
   "end": 298.399,
   "text": "你翻出三年前存的那张截图，那时你也这么说话"
  },
  {
   "start": 298.399,
   "end": 301.347,
   "text": "你找到自己那条评论，点了删除"
  },
  {
   "start": 301.347,
   "end": 305.129,
   "text": "你在下面留了一行字：土木工程，垃圾专业"
  },
  {
   "start": 305.129,
   "end": 308.494,
   "text": "有人回你，说你就是被劝退的那种人"
  },
  {
   "start": 308.494,
   "end": 311.026,
   "text": "你没有回，你决定提桶跑路"
  },
  {
   "start": 311.026,
   "end": 315.224,
   "text": "第二天你去镇上买了个红色塑料桶，二十八块"
  },
  {
   "start": 315.224,
   "end": 318.589,
   "text": "红桶是工地最体面的行李，谁都认得"
  },
  {
   "start": 318.589,
   "end": 321.954,
   "text": "你提着桶走回项目部，路上遇见工长"
  },
  {
   "start": 321.954,
   "end": 325.527,
   "text": "他问你去干什么，你说收东西，明天就走"
  },
  {
   "start": 325.527,
   "end": 327.85,
   "text": "桶刚放在床边，手机响了"
  },
  {
   "start": 327.85,
   "end": 330.59,
   "text": "工长说，明天六点浇筑，别迟到"
  },
  {
   "start": 330.59,
   "end": 333.122,
   "text": "你把衣服又放回了柜子里"
  },
  {
   "start": 333.122,
   "end": 335.862,
   "text": "那天晚上下了雨，宿舍顶漏了"
  },
  {
   "start": 335.862,
   "end": 338.394,
   "text": "你把桶挪到了漏水的地方"
  },
  {
   "start": 338.394,
   "end": 341.134,
   "text": "桶接了一夜的水，声音很规律"
  },
  {
   "start": 341.134,
   "end": 343.457,
   "text": "你听着那个声音睡着了"
  },
  {
   "start": 343.457,
   "end": 347.482,
   "text": "第二天早上六点，你准时站在工地上"
  }
 ],
 "max_chars": 20
}