{
 "cues": [
  {
   "start": 0.0,
   "end": 4.0,
   "text": "晚上九点四十分，你拎着帆布包走出写字楼"
  },
  {
   "start": 4.0,
   "end": 6.733,
   "text": "晚高峰的地铁晃了四十分钟"
  },
  {
   "start": 6.733,
   "end": 9.267,
   "text": "回到出租屋时已经十点半"
  },
  {
   "start": 9.267,
   "end": 13.467,
   "text": "钥匙插进锁孔拧动，金属门把手凉得指尖一缩"
  },
  {
   "start": 13.467,
   "end": 16.246463414634146,
   "text": "你顺手把外卖盒放在玄关地上"
  },
  {
   "start": 16.246463414634146,
   "end": 19.667341463414633,
   "text": "胳膊肘撑着窗台刷了二十分钟短视频"
  },
  {
   "start": 19.667341463414633,
   "end": 22.233,
   "text": "玻璃上蒙了一层淡淡的水雾"
  },
  {
   "start": 22.233,
   "end": 26.133,
   "text": "洗完澡换上薄睡衣，脏衣服随手搭在椅背上"
  },
  {
   "start": 26.133,
   "end": 28.733,
   "text": "定好七点半的闹钟，关灯躺平"
  },
  {
   "start": 28.733,
   "end": 31.9,
   "text": "和过去几百个夜晚没有任何区别"
  },
  {
   "start": 31.9,
   "end": 33.42124,
   "text": "凌晨两点零七分"
  },
  {
   "start": 33.42124,
   "end": 37.333,
   "text": "楼道里传来一声短促的尖叫，然后戛然而止"
  },
  {
   "start": 37.333,
   "end": 39.704875,
   "text": "你被吵醒，皱着眉翻了个身"
  },
  {
   "start": 39.704875,
   "end": 42.292375,
   "text": "嘟囔了一句“大半夜发什么疯”"
  },
  {
   "start": 42.292375,
   "end": 44.233,
   "text": "裹紧被子又睡了过去"
  },
  {
   "start": 44.233,
   "end": 47.068083333333334,
   "text": "天刚亮你就醒了，外面异常安静"
  },
  {
   "start": 47.068083333333334,
   "end": 49.467,
   "text": "连清晨的车流声都消失了"
  },
  {
   "start": 49.467,
   "end": 52.4,
   "text": "凑到猫眼看，楼道里站着几个人"
  },
  {
   "start": 52.4,
   "end": 55.64193548387097,
   "text": "一个穿着睡衣，背靠着墙，头歪向一边"
  },
  {
   "start": 55.64193548387097,
   "end": 59.1,
   "text": "另一个垂着手臂，身体僵直地晃来晃去"
  },
  {
   "start": 59.1,
   "end": 62.98888888888889,
   "text": "你一开始以为他们是出了什么意外"
  },
  {
   "start": 62.98888888888889,
   "end": 66.1,
   "text": "隔着门问了一声：“你们还好吗？”"
  },
  {
   "start": 66.1,
   "end": 67.233,
   "text": "没人回答"
  },
  {
   "start": 67.233,
   "end": 71.633,
   "text": "靠得最近的那个人慢慢抬起头，脸几乎贴上猫眼"
  },
  {
   "start": 71.633,
   "end": 75.633,
   "text": "你吓得退开，反锁房门，把鞋柜推过去顶住门"
  },
  {
   "start": 75.633,
   "end": 80.033,
   "text": "你还不知道他们是什么，只觉得这些人不太对劲"
  },
  {
   "start": 80.033,
   "end": 83.06649999999999,
   "text": "你捂住嘴不敢出声，连呼吸都放轻"
  },
  {
   "start": 83.06649999999999,
   "end": 86.1,
   "text": "心想只要安静，他们也许就会离开"
  },
  {
   "start": 86.1,
   "end": 90.3,
   "text": "但整整一天过去，门外的人没走，反而越聚越多"
  },
  {
   "start": 90.3,
   "end": 92.02882758620689,
   "text": "他们不撞门，不说话"
  },
  {
   "start": 92.02882758620689,
   "end": 94.83817241379309,
   "text": "只是安安静静地贴在门板附近"
  },
  {
   "start": 94.83817241379309,
   "end": 96.567,
   "text": "偶尔缓缓挪动几步"
  },
  {
   "start": 96.567,
   "end": 99.63366666666667,
   "text": "你很疑惑——你明明连杯水都没敢倒"
  },
  {
   "start": 99.63366666666667,
   "end": 101.167,
   "text": "一点声音都没出"
  },
  {
   "start": 101.167,
   "end": 105.263875,
   "text": "你隔着猫眼观察了很久，发现楼道里有一个人"
  },
  {
   "start": 105.263875,
   "end": 108.067,
   "text": "穿着隔壁老刘常穿的蓝色外套"
  },
  {
   "start": 108.067,
   "end": 109.60477272727272,
   "text": "老刘住在你隔壁"
  },
  {
   "start": 109.60477272727272,
   "end": 112.9,
   "text": "昨天早上还在楼道里跟你打过招呼"
  },
  {
   "start": 112.9,
   "end": 117.00645161290322,
   "text": "可现在的他脸色灰白，嘴角挂着暗红色的痕迹"
  },
  {
   "start": 117.00645161290322,
   "end": 119.6,
   "text": "脖子上有一道不规则的伤口"
  },
  {
   "start": 119.6,
   "end": 121.57142857142857,
   "text": "他就那么靠着墙站着"
  },
  {
   "start": 121.57142857142857,
   "end": 124.2,
   "text": "眼睛半睁，像是根本没看见你"
  },
  {
   "start": 124.2,
   "end": 127.567,
   "text": "你隔着门喊了两声“老刘”，他没有反应"
  },
  {
   "start": 127.567,
   "end": 129.667,
   "text": "你又用指节敲了敲门"
  },
  {
   "start": 129.667,
   "end": 132.4,
   "text": "声音不大，但足以让隔壁听见"
  },
  {
   "start": 132.4,
   "end": 136.167,
   "text": "楼道里的人没有一个转头，老刘也没有动"
  },
  {
   "start": 136.167,
   "end": 139.933,
   "text": "你试着验证“声音会把他们引过来”的猜想"
  },
  {
   "start": 139.933,
   "end": 142.53314285714285,
   "text": "你把枕头扔在地上，闷响一声"
  },
  {
   "start": 142.53314285714285,
   "end": 146.0,
   "text": "又用指甲轻轻刮了刮墙面，细碎的声响"
  },
  {
   "start": 146.0,
   "end": 148.333,
   "text": "门外的人还是没有反应"
  },
  {
   "start": 148.333,
   "end": 151.9,
   "text": "你慢慢退回客厅，走到窗边看了看楼下"
  },
  {
   "start": 151.9,
   "end": 155.35000000000002,
   "text": "墙根有几个人影在游荡，你盯了一会儿"
  },
  {
   "start": 155.35000000000002,
   "end": 158.8,
   "text": "他们没有抬头，也没有朝你的窗户靠近"
  },
  {
   "start": 158.8,
   "end": 160.5,
   "text": "你重新看向猫眼"
  },
  {
   "start": 160.5,
   "end": 163.667,
   "text": "老刘仍旧站在原地，肩膀一动不动"
  },
  {
   "start": 163.667,
   "end": 167.233,
   "text": "你开始害怕的，不只是楼道里有没有人"
  },
  {
   "start": 167.233,
   "end": 170.8,
   "text": "你不知道门外那些东西还算不算活人"
  },
  {
   "start": 170.8,
   "end": 173.333,
   "text": "你决定做个冒险的小测试"
  },
  {
   "start": 173.333,
   "end": 175.9594347826087,
   "text": "你把一串备用钥匙放在门边"
  },
  {
   "start": 175.9594347826087,
   "end": 178.367,
   "text": "又找来一只干净的塑料瓶"
  },
  {
   "start": 178.367,
   "end": 182.45,
   "text": "楼道里暂时没有脚步声，你把门打开一条窄缝"
  },
  {
   "start": 182.45,
   "end": 186.533,
   "text": "用长柄夹子先把塑料瓶放到门外，再迅速关上"
  },
  {
   "start": 186.533,
   "end": 187.6282380952381,
   "text": "十分钟过去"
  },
  {
   "start": 187.6282380952381,
   "end": 191.133,
   "text": "附近的人没有一只朝瓶子的方向移动"
  },
  {
   "start": 191.133,
   "end": 193.51041935483872,
   "text": "你等到楼道再次安静下来"
  },
  {
   "start": 193.51041935483872,
   "end": 197.833,
   "text": "才把自己握了十分钟的钥匙串放到同一个位置"
  },
  {
   "start": 197.833,
   "end": 200.367,
   "text": "你关上门，贴在猫眼后面看"
  },
  {
   "start": 200.367,
   "end": 204.267,
   "text": "过了一会儿，离得最近的两个人慢慢转过身"
  },
  {
   "start": 204.267,
   "end": 206.867,
   "text": "一步一步朝钥匙串挪了过去"
  },
  {
   "start": 206.867,
   "end": 208.967,
   "text": "你后背泛起一阵凉意"
  },
  {
   "start": 208.967,
   "end": 211.3,
   "text": "那串钥匙没有发出声音"
  },
  {
   "start": 211.3,
   "end": 215.067,
   "text": "它们却像是闻到了什么，直直地朝它靠近"
  },
  {
   "start": 215.067,
   "end": 218.94825,
   "text": "你想起老刘灰白的脸，想起他脖子上的伤口"
  },
  {
   "start": 218.94825,
   "end": 221.967,
   "text": "想起他听见你喊名字也没有反应"
  },
  {
   "start": 221.967,
   "end": 225.333,
   "text": "直到这时，你才终于把那个词说出口"
  },
  {
   "start": 225.333,
   "end": 227.133,
   "text": "丧尸"
  },
  {
   "start": 227.133,
   "end": 229.033,
   "text": "你开始针对性验证"
  },
  {
   "start": 229.033,
   "end": 232.52038461538461,
   "text": "早上，你用湿抹布反复擦了三遍门把手"
  },
  {
   "start": 232.52038461538461,
   "end": 234.7,
   "text": "也擦了门外一小块地面"
  },
  {
   "start": 234.7,
   "end": 236.64999999999998,
   "text": "接下来的两个小时里"
  },
  {
   "start": 236.64999999999998,
   "end": 239.24999999999997,
   "text": "门口的丧尸慢慢散开了一些"
  },
  {
   "start": 239.24999999999997,
   "end": 241.2,
   "text": "不再死死贴在门板上"
  },
  {
   "start": 241.2,
   "end": 244.24248,
   "text": "下午，你用纸巾隔着手握住门把手"
  },
  {
   "start": 244.24248,
   "end": 246.633,
   "text": "再把门外那块地面擦干净"
  },
  {
   "start": 246.633,
   "end": 250.2,
   "text": "半小时后，散开的丧尸又慢慢聚了回来"
  },
  {
   "start": 250.2,
   "end": 252.3667857142857,
   "text": "你不知道是门把手、地面"
  },
  {
   "start": 252.3667857142857,
   "end": 256.267,
   "text": "还是开门时漏出去的气味把它们引了回来"
  },
  {
   "start": 256.267,
   "end": 259.9716923076923,
   "text": "但你注意到，门口的丧尸总会聚在你开门"
  },
  {
   "start": 259.9716923076923,
   "end": 261.933,
   "text": "倒垃圾和换气的地方"
  },
  {
   "start": 261.933,
   "end": 265.16027272727274,
   "text": "你把这几次情况记在本子上：人碰过"
  },
  {
   "start": 265.16027272727274,
   "end": 269.033,
   "text": "待过的地方，似乎会留下它们能察觉的东西"
  },
  {
   "start": 269.033,
   "end": 270.933,
   "text": "你发现了更多规律"
  },
  {
   "start": 270.933,
   "end": 273.71217391304344,
   "text": "常坐的那把餐椅正对着的窗外"
  },
  {
   "start": 273.71217391304344,
   "end": 276.06378260869565,
   "text": "丧尸数量总比别的窗台多"
  },
  {
   "start": 276.06378260869565,
   "end": 278.6291739130435,
   "text": "玄关放了两天的外卖盒旁边"
  },
  {
   "start": 278.6291739130435,
   "end": 280.767,
   "text": "门外的丧尸也明显更密"
  },
  {
   "start": 280.767,
   "end": 285.04606976744185,
   "text": "你踩着拖鞋在屋里走了一下午，傍晚时偶然发现"
  },
  {
   "start": 285.04606976744185,
   "end": 288.25537209302325,
   "text": "你常走的那条路线对应的窗外墙根"
  },
  {
   "start": 288.25537209302325,
   "end": 289.967,
   "text": "慢慢聚了几只丧尸"
  },
  {
   "start": 289.967,
   "end": 291.92830769230767,
   "text": "你一开始没反应过来"
  },
  {
   "start": 291.92830769230767,
   "end": 295.633,
   "text": "直到低头看见拖鞋底沾着的皮屑和灰尘"
  },
  {
   "start": 295.633,
   "end": 296.9330714285714,
   "text": "你不确定它们"
  },
  {
   "start": 296.9330714285714,
   "end": 300.18325,
   "text": "是不是顺着空气里的气味找过来的"
  },
  {
   "start": 300.18325,
   "end": 301.7,
   "text": "但你不敢继续赌"
  },
  {
   "start": 301.7,
   "end": 305.7878787878788,
   "text": "你把拖鞋装进垃圾袋，改穿干净袜子在屋里走"
  },
  {
   "start": 305.7878787878788,
   "end": 308.8,
   "text": "常走的路线也用湿拖把擦了一遍"
  },
  {
   "start": 308.8,
   "end": 313.0,
   "text": "你不敢把门长时间打开，也没有仪器测量痕迹"
  },
  {
   "start": 313.0,
   "end": 315.733,
   "text": "能做的只有几次短暂的观察"
  },
  {
   "start": 315.733,
   "end": 319.0160434782609,
   "text": "早上，你把一小块干净布料放到门外"
  },
  {
   "start": 319.0160434782609,
   "end": 320.767,
   "text": "关门后从猫眼观察"
  },
  {
   "start": 320.767,
   "end": 323.3,
   "text": "附近的丧尸没有明显反应"
  },
  {
   "start": 323.3,
   "end": 326.1166666666667,
   "text": "中午，你握住另一块布料一会儿"
  },
  {
   "start": 326.1166666666667,
   "end": 329.8,
   "text": "再趁楼道安静时把它放到差不多的位置"
  },
  {
   "start": 329.8,
   "end": 333.167,
   "text": "过了一阵，有两只丧尸慢慢挪了过去"
  },
  {
   "start": 333.167,
   "end": 336.64412,
   "text": "你不敢确定这是布料上的痕迹引起的"
  },
  {
   "start": 336.64412,
   "end": 338.6,
   "text": "还是它们刚好在移动"
  },
  {
   "start": 338.6,
   "end": 340.7,
   "text": "傍晚，你把布料收回来"
  },
  {
   "start": 340.7,
   "end": 344.61133333333333,
   "text": "楼道里的丧尸没有跟着门口的动作冲过来"
  },
  {
   "start": 344.61133333333333,
   "end": 346.567,
   "text": "只在原地停了一会儿"
  },
  {
   "start": 346.567,
   "end": 350.333,
   "text": "你把记录写进本子，却没写“规律已经确认”"
  },
  {
   "start": 350.333,
   "end": 352.667,
   "text": "样本太少，变化也不稳定"
  },
  {
   "start": 352.667,
   "end": 356.76485294117646,
   "text": "你只能先相信：人留下的痕迹可能会吸引它们"
  },
  {
   "start": 356.76485294117646,
   "end": 360.0,
   "text": "新的、明显的痕迹似乎更容易被发现"
  },
  {
   "start": 360.0,
   "end": 362.3481489361702,
   "text": "完成第一轮去痕迹改造后"
  },
  {
   "start": 362.3481489361702,
   "end": 366.1905744680851,
   "text": "你很快想通了更麻烦的问题：单点痕迹能擦"
  },
  {
   "start": 366.1905744680851,
   "end": 370.033,
   "text": "但整个房间都住着人，痕迹迟早会越积越多"
  },
  {
   "start": 370.033,
   "end": 371.99575,
   "text": "你翻看这几天的记录"
  },
  {
   "start": 371.99575,
   "end": 375.267,
   "text": "试着按丧尸数量画了一条增长曲线"
  },
  {
   "start": 375.267,
   "end": 378.633,
   "text": "数字少得可怜，观察的位置也不一样"
  },
  {
   "start": 378.633,
   "end": 380.8138333333333,
   "text": "你画出来的线忽高忽低"
  },
  {
   "start": 380.8138333333333,
   "end": 383.867,
   "text": "根本算不出什么时候会彻底堵死"
  },
  {
   "start": 383.867,
   "end": 386.2,
   "text": "你不是没想过立刻就走"
  },
  {
   "start": 386.2,
   "end": 390.2762307692308,
   "text": "但窗外的街道空荡荡的，你连外面有多少丧尸"
  },
  {
   "start": 390.2762307692308,
   "end": 394.567,
   "text": "往哪走安全都不知道，空手冲出去，和送死没区别"
  },
  {
   "start": 394.567,
   "end": 398.967,
   "text": "信息为零的时候，固守看起来是成本最低的选择"
  },
  {
   "start": 398.967,
   "end": 402.2258888888889,
   "text": "你给自己定下计划：先苟着，摸透规则"
  },
  {
   "start": 402.2258888888889,
   "end": 404.833,
   "text": "补够物资，暂定第19天出发"
  },
  {
   "start": 404.833,
   "end": 409.233,
   "text": "这不是算出来的安全日，只是你给自己留的期限"
  },
  {
   "start": 409.233,
   "end": 412.7203846153846,
   "text": "你在笔记本上画了一条粗略的增长线"
  },
  {
   "start": 412.7203846153846,
   "end": 414.9,
   "text": "旁边写着“估计，误差很大”"
  },
  {
   "start": 414.9,
   "end": 417.2984583333333,
   "text": "你以为只要每天继续观察"
  },
  {
   "start": 417.2984583333333,
   "end": 420.133,
   "text": "就能在危险真正到来前看懂它"
  },
  {
   "start": 420.133,
   "end": 425.0,
   "text": "可你手里的记录，连一条可靠的曲线都算不上"
  },
  {
   "start": 425.0,
   "end": 427.82485185185186,
   "text": "清晨醒来，你心头一沉——卧室窗外"
  },
  {
   "start": 427.82485185185186,
   "end": 430.867,
   "text": "又聚了七八只丧尸，贴着玻璃站着"
  },
  {
   "start": 430.867,
   "end": 434.4988181818182,
   "text": "你睡了七个小时，躺在床上，皮肤接触床单"
  },
  {
   "start": 434.4988181818182,
   "end": 437.70336363636363,
   "text": "体温和皮屑留在上面，一整晚的时间"
  },
  {
   "start": 437.70336363636363,
   "end": 440.267,
   "text": "形成了一个明显的痕迹锚点"
  },
  {
   "start": 440.267,
   "end": 444.467,
   "text": "窗户没有关严，屋里的气味顺着缝隙散了出去"
  },
  {
   "start": 444.467,
   "end": 447.09291304347823,
   "text": "你立刻卷起床单，装进垃圾袋"
  },
  {
   "start": 447.09291304347823,
   "end": 449.5,
   "text": "等到楼道安静时才拿出去"
  },
  {
   "start": 449.5,
   "end": 452.667,
   "text": "直到下午，窗外的丧尸才慢慢散开"
  },
  {
   "start": 452.667,
   "end": 455.7086296296296,
   "text": "你开始每晚换地方睡：今晚睡沙发"
  },
  {
   "start": 455.7086296296296,
   "end": 458.533,
   "text": "明晚睡地板，后晚去玄关打地铺"
  },
  {
   "start": 458.533,
   "end": 462.8381428571429,
   "text": "每次睡之前铺一层一次性床单，醒了就卷走收好"
  },
  {
   "start": 462.8381428571429,
   "end": 466.067,
   "text": "尽量不在一个地方留下连续的痕迹"
  },
  {
   "start": 466.067,
   "end": 468.167,
   "text": "降温了，室内温度很低"
  },
  {
   "start": 468.167,
   "end": 471.62410344827583,
   "text": "你站在窗边想看看外面，刚凑过去几秒"
  },
  {
   "start": 471.62410344827583,
   "end": 474.433,
   "text": "玻璃上就蒙了一层呼吸的水雾"
  },
  {
   "start": 474.433,
   "end": 477.167,
   "text": "你没当回事，擦干净就走开了"
  },
  {
   "start": 477.167,
   "end": 480.84992857142856,
   "text": "半小时后再回来，窗外居然聚了四只丧尸"
  },
  {
   "start": 480.84992857142856,
   "end": 483.233,
   "text": "正对着你刚才哈气的位置"
  },
  {
   "start": 483.233,
   "end": 486.4,
   "text": "你不确定它们是不是被水雾吸引"
  },
  {
   "start": 486.4,
   "end": 488.37713636363634,
   "text": "也可能是你扶过窗框"
  },
  {
   "start": 488.37713636363634,
   "end": 491.233,
   "text": "或者那一带原本就有更多痕迹"
  },
  {
   "start": 491.233,
   "end": 494.25844827586207,
   "text": "可从那天起，你不再把脸凑近玻璃"
  },
  {
   "start": 494.25844827586207,
   "end": 497.5,
   "text": "观察外面都隔着半米，尽量不碰窗台"
  },
  {
   "start": 497.5,
   "end": 499.6882608695652,
   "text": "你的生活变得极轻、极慢"
  },
  {
   "start": 499.6882608695652,
   "end": 502.533,
   "text": "像一道影子一样在屋子里移动"
  },
  {
   "start": 502.533,
   "end": 506.1533703703704,
   "text": "走路尽量走房间中间，不蹭到墙面和家具"
  },
  {
   "start": 506.1533703703704,
   "end": 508.495962962963,
   "text": "每天捡一遍地上掉的头发"
  },
  {
   "start": 508.495962962963,
   "end": 511.4774444444445,
   "text": "包好收起来；喝水用吸管，不碰杯口"
  },
  {
   "start": 511.4774444444445,
   "end": 514.033,
   "text": "吃饭慢慢嚼，不让餐具碰出声"
  },
  {
   "start": 514.033,
   "end": 518.233,
   "text": "物资开始紧张，泡面只剩三桶，瓶装水还有半箱"
  },
  {
   "start": 518.233,
   "end": 520.833,
   "text": "你没急着出门——规则还没摸透"
  },
  {
   "start": 520.833,
   "end": 524.733,
   "text": "长途移动等于在身后留下一串可能的痕迹"
  },
  {
   "start": 524.733,
   "end": 527.5206216216216,
   "text": "你先规划了小区内的短途路线"
  },
  {
   "start": 527.5206216216216,
   "end": 529.4505135135134,
   "text": "走楼梯，尽量不碰扶手"
  },
  {
   "start": 529.4505135135134,
   "end": 532.667,
   "text": "目标是小区门口的超市，五百米距离"
  },
  {
   "start": 532.667,
   "end": 537.067,
   "text": "你反复在脑子里演练开门、关门、擦掉碰过的地方"
  },
  {
   "start": 537.067,
   "end": 538.3799565217391,
   "text": "可你知道，脚底"
  },
  {
   "start": 538.3799565217391,
   "end": 542.1,
   "text": "衣服和呼吸留下的东西不可能全擦干净"
  },
  {
   "start": 542.1,
   "end": 546.3,
   "text": "你能做的只是少碰、少留，赌丧尸不会立刻跟来"
  },
  {
   "start": 546.3,
   "end": 547.8,
   "text": "阴天，空气发闷"
  },
  {
   "start": 547.8,
   "end": 548.933,
   "text": "你出发了"
  },
  {
   "start": 548.933,
   "end": 552.3998571428572,
   "text": "戴两层一次性手套，用胳膊肘顶开房门"
  },
  {
   "start": 552.3998571428572,
   "end": 555.0,
   "text": "踮着脚走出去，再轻轻带上门"
  },
  {
   "start": 555.0,
   "end": 556.2895263157894,
   "text": "你擦了门把手"
  },
  {
   "start": 556.2895263157894,
   "end": 559.5133421052632,
   "text": "却没法擦掉脚下走过的每一级台阶"
  },
  {
   "start": 559.5133421052632,
   "end": 563.167,
   "text": "也没法控制衣服擦过扶手时留下的痕迹"
  },
  {
   "start": 563.167,
   "end": 565.5437586206897,
   "text": "楼道里的丧尸慢悠悠晃着"
  },
  {
   "start": 565.5437586206897,
   "end": 569.433,
   "text": "你从它们身边走过去，它们没有立刻转向你"
  },
  {
   "start": 569.433,
   "end": 572.167,
   "text": "五百米的路，你走了四十分钟"
  },
  {
   "start": 572.167,
   "end": 574.9766774193548,
   "text": "超市里一片狼藉，货架倒了一半"
  },
  {
   "start": 574.9766774193548,
   "end": 578.867,
   "text": "但角落还有不少没被拿走的泡面和瓶装水"
  },
  {
   "start": 578.867,
   "end": 581.6913703703704,
   "text": "你用超市里的新购物袋垫着手"
  },
  {
   "start": 581.6913703703704,
   "end": 584.733,
   "text": "搬了两箱水和五包泡面，原路返回"
  },
  {
   "start": 584.733,
   "end": 588.1,
   "text": "回到楼里时，楼梯转角多了两只丧尸"
  },
  {
   "start": 588.1,
   "end": 591.8053461538462,
   "text": "它们没有追上来，只停在你走过的台阶旁"
  },
  {
   "start": 591.8053461538462,
   "end": 593.767,
   "text": "朝着那一带慢慢挪动"
  },
  {
   "start": 593.767,
   "end": 597.133,
   "text": "你不敢确认它们是不是被你引来的"
  },
  {
   "start": 597.133,
   "end": 600.374551724138,
   "text": "回到家关上门的那一刻，你松了口气"
  },
  {
   "start": 600.374551724138,
   "end": 603.4,
   "text": "短途移动似乎没有立刻引来围堵"
  },
  {
   "start": 603.4,
   "end": 606.767,
   "text": "你把两只丧尸的位置画在笔记本上"
  },
  {
   "start": 606.767,
   "end": 610.533,
   "text": "这次出门没出事，但并不能证明路线安全"
  },
  {
   "start": 610.533,
   "end": 614.3,
   "text": "每趟外出，都可能把痕迹留在回家的路上"
  },
  {
   "start": 614.3,
   "end": 618.5,
   "text": "你在超市收银台捡到了一个还能用的收音机"
  },
  {
   "start": 618.5,
   "end": 622.7752173913043,
   "text": "调试了很久，终于收到一段断断续续的官方广播"
  },
  {
   "start": 622.7752173913043,
   "end": 624.4853043478261,
   "text": "城郊体育馆安置点"
  },
  {
   "start": 624.4853043478261,
   "end": 628.333,
   "text": "每天中午十二点有接驳车，持续到第19天"
  },
  {
   "start": 628.333,
   "end": 632.533,
   "text": "第19天最后一班车离开后，安置点停止接应"
  },
  {
   "start": 632.533,
   "end": 636.7776666666667,
   "text": "你没法确认广播是不是最新的，只把城郊体育馆"
  },
  {
   "start": 636.7776666666667,
   "end": 639.7489333333334,
   "text": "当成唯一有明确方向的逃生目标"
  },
  {
   "start": 639.7489333333334,
   "end": 642.5079666666668,
   "text": "五公里路程，沿途多是老居民区"
  },
  {
   "start": 642.5079666666668,
   "end": 645.267,
   "text": "比主干道更容易避开空旷地带"
  },
  {
   "start": 645.267,
   "end": 648.725064516129,
   "text": "你还有几天可以出发，但每天多留一天"
  },
  {
   "start": 648.725064516129,
   "end": 651.967,
   "text": "物资就少一点，门外的影子也多一点"
  },
  {
   "start": 651.967,
   "end": 654.7913703703704,
   "text": "你决定等一个可能有利的天气"
  },
  {
   "start": 654.7913703703704,
   "end": 657.833,
   "text": "再赶在第19天中午前到体育馆"
  },
  {
   "start": 657.833,
   "end": 661.284294117647,
   "text": "天气越来越潮，你把雾天当成一个机会"
  },
  {
   "start": 661.284294117647,
   "end": 665.167,
   "text": "也许潮湿的空气能让痕迹不那么容易飘远"
  },
  {
   "start": 665.167,
   "end": 668.1,
   "text": "你没有证据，只能赌它比晴天好"
  },
  {
   "start": 668.1,
   "end": 671.033,
   "text": "第16天起，空气明显闷了下来"
  },
  {
   "start": 671.033,
   "end": 673.388925,
   "text": "墙面返潮，玻璃一摸一层水"
  },
  {
   "start": 673.388925,
   "end": 676.8157249999999,
   "text": "远处的楼顶整天蒙在灰蒙蒙的雾气里"
  },
  {
   "start": 676.8157249999999,
   "end": 679.6,
   "text": "连楼下丧尸的轮廓都变得模糊"
  },
  {
   "start": 679.6,
   "end": 683.7166666666667,
   "text": "夜里开窗，能闻到泥土和潮气混在一起的味道"
  },
  {
   "start": 683.7166666666667,
   "end": 686.1,
   "text": "烟飘出去半米就沉了下去"
  },
  {
   "start": 686.1,
   "end": 689.1258064516129,
   "text": "你很熟悉这种征兆——秋冬的老城区"
  },
  {
   "start": 689.1258064516129,
   "end": 692.8,
   "text": "这种天气再憋一两天，可能会下一场大雾"
  },
  {
   "start": 692.8,
   "end": 696.6685789473684,
   "text": "你对着笔记本重新看了一遍：第8天、12天"
  },
  {
   "start": 696.6685789473684,
   "end": 700.967,
   "text": "17天，窗外那片墙根附近的影子一次比一次多"
  },
  {
   "start": 700.967,
   "end": 702.476375,
   "text": "但你把不同位置"
  },
  {
   "start": 702.476375,
   "end": 705.4951249999999,
   "text": "不同时间看到的影子记在了一起"
  },
  {
   "start": 705.4951249999999,
   "end": 707.867,
   "text": "以为数量还是在慢慢增加"
  },
  {
   "start": 707.867,
   "end": 710.2654583333333,
   "text": "趁大雾出发，可能看不清路"
  },
  {
   "start": 710.2654583333333,
   "end": 713.1,
   "text": "也可能让痕迹不那么容易扩散"
  },
  {
   "start": 713.1,
   "end": 716.604761904762,
   "text": "你没有把握，只能在笔记本上写下“雾天"
  },
  {
   "start": 716.604761904762,
   "end": 717.7,
   "text": "或许更安全”"
  },
  {
   "start": 717.7,
   "end": 721.6233076923077,
   "text": "五公里的路，按你上次五百米走四十分钟算"
  },
  {
   "start": 721.6233076923077,
   "end": 723.367,
   "text": "至少要六个多小时"
  },
  {
   "start": 723.367,
   "end": 727.0499285714286,
   "text": "你把闹钟调到凌晨三点半，决定四点出门"
  },
  {
   "start": 727.0499285714286,
   "end": 729.433,
   "text": "尽量在中午前赶到体育馆"
  },
  {
   "start": 729.433,
   "end": 732.4927272727273,
   "text": "你把能想到的风险都列了出来"
  },
  {
   "start": 732.4927272727273,
   "end": 737.2,
   "text": "却把那些不完整的记录，当成了足够可靠的答案"
  },
  {
   "start": 737.2,
   "end": 739.6070869565217,
   "text": "下午你出门补了一次物资"
  },
  {
   "start": 739.6070869565217,
   "end": 742.233,
   "text": "这次走了和上次不同的路线"
  },
  {
   "start": 742.233,
   "end": 745.8702093023255,
   "text": "回来时，楼梯转角的丧尸比昨天更多了些"
  },
  {
   "start": 745.8702093023255,
   "end": 749.5074186046511,
   "text": "但你没法确定它们是被你的痕迹引来的"
  },
  {
   "start": 749.5074186046511,
   "end": 751.433,
   "text": "还是正在向别处移动"
  },
  {
   "start": 751.433,
   "end": 755.1404166666667,
   "text": "潮气越来越重，楼道的墙面已经开始渗水"
  },
  {
   "start": 755.1404166666667,
   "end": 756.667,
   "text": "空气里雾蒙蒙的"
  },
  {
   "start": 756.667,
   "end": 759.833,
   "text": "按经验，后半夜雾就会彻底降下来"
  },
  {
   "start": 759.833,
   "end": 764.033,
   "text": "你收拾好背包，等着天一亮、雾最浓的时候出发"
  },
  {
   "start": 764.033,
   "end": 767.2,
   "text": "为了不浪费体力，你很早就躺下了"
  },
  {
   "start": 767.2,
   "end": 769.80784,
   "text": "临睡前，你又检查了一遍背包"
  },
  {
   "start": 769.80784,
   "end": 772.633,
   "text": "来回走了几趟，把东西重新摆放"
  },
  {
   "start": 772.633,
   "end": 775.0048750000001,
   "text": "你以为这点活动不算什么"
  },
  {
   "start": 775.0048750000001,
   "end": 778.023625,
   "text": "却没留意到门口和走廊里的影子"
  },
  {
   "start": 778.023625,
   "end": 779.533,
   "text": "整晚都没有散开"
  },
  {
   "start": 779.533,
   "end": 783.3,
   "text": "凌晨三点四十，你醒得比闹钟早了几分钟"
  },
  {
   "start": 783.3,
   "end": 786.3514615384615,
   "text": "四点出门，走五公里，按上次的速度"
  },
  {
   "start": 786.3514615384615,
   "end": 788.967,
   "text": "应该能在中午前赶到体育馆"
  },
  {
   "start": 788.967,
   "end": 792.133,
   "text": "你没开灯，径直走到玄关，凑向猫眼"
  },
  {
   "start": 792.133,
   "end": 794.867,
   "text": "视野里塞满了灰白色的身影"
  },
  {
   "start": 794.867,
   "end": 797.2308421052632,
   "text": "楼道里密密麻麻全是丧尸"
  },
  {
   "start": 797.2308421052632,
   "end": 800.0244736842105,
   "text": "从家门口堆到楼梯转角，贴着墙"
  },
  {
   "start": 800.0244736842105,
   "end": 803.033,
   "text": "贴着门板，一动不动，像凝固的黑影"
  },
  {
   "start": 803.033,
   "end": 805.567,
   "text": "你退后半步，没慌，也没意外"
  },
  {
   "start": 805.567,
   "end": 809.4573225806452,
   "text": "走到窗边往下看，整栋楼的墙根下全是丧尸"
  },
  {
   "start": 809.4573225806452,
   "end": 812.267,
   "text": "层层叠叠围着这一层，看不到头"
  },
  {
   "start": 812.267,
   "end": 813.5850909090909,
   "text": "你翻开笔记本"
  },
  {
   "start": 813.5850909090909,
   "end": 817.1,
   "text": "前几天的数字还歪歪扭扭地记在纸上"
  },
  {
   "start": 817.1,
   "end": 818.3937500000001,
   "text": "你把不同位置"
  },
  {
   "start": 818.3937500000001,
   "end": 821.84375,
   "text": "不同时间看到的影子当成同一组数据"
  },
  {
   "start": 821.84375,
   "end": 824.0,
   "text": "以为数量只是慢慢增加"
  },
  {
   "start": 824.0,
   "end": 825.5377727272727,
   "text": "现在你终于明白"
  },
  {
   "start": 825.5377727272727,
   "end": 828.833,
   "text": "自己根本没看懂它们是怎么变多的"
  },
  {
   "start": 828.833,
   "end": 830.333,
   "text": "差了几个小时"
  },
  {
   "start": 830.333,
   "end": 831.467,
   "text": "雾快来了"
  },
  {
   "start": 831.467,
   "end": 835.667,
   "text": "你放下背包，退到这几天一直擦过的房间中央"
  },
  {
   "start": 835.667,
   "end": 839.033,
   "text": "那里不一定安全，但至少离门远一点"
  },
  {
   "start": 839.033,
   "end": 841.4425238095239,
   "text": "门外的黑影还在慢慢变多"
  },
  {
   "start": 841.4425238095239,
   "end": 843.633,
   "text": "安静得像涨起来的潮水"
  },
  {
   "start": 843.633,
   "end": 846.567,
   "text": "窗外渐渐发白，你等着雾落下来"
  },
  {
   "start": 846.567,
   "end": 847.7,
   "text": "第十九天"
  },
  {
   "start": 847.7,
   "end": 849.5,
   "text": "没跑赢"
  }
 ],
 "max_chars": 20
}